// StarClubИнтеграция — загальний модуль 1С
// Властивості модуля: Сервер = Так, Клієнт = Так, Зовнішнє з'єднання = Так, Виклик сервера = Так.
// Для Railway в АдресСервера вписувати домен \\без https://

Функция StarClubАдресСервера() Экспорт
	Возврат "web-production-83a01.up.railway.app";
КонецФункции

Функция StarClubПортСервера() Экспорт
	Возврат 443;
КонецФункции

Функция StarClubКлючAPI() Экспорт
	// Має співпадати з Railway Variables: ONE_C_API_TOKEN
	Возврат "change-this-1c-token";
КонецФункции

Функция StarClubHTTPСоединение() Экспорт
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Возврат Новый HTTPСоединение(
		StarClubАдресСервера(),
		StarClubПортСервера(),
		,
		,
		,
		30,
		ЗащищенноеСоединение
	);
КонецФункции

Функция StarClubPOST(ПутьAPI, Данные) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	HTTPЗапрос = Новый HTTPЗапрос(ПутьAPI);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	HTTPЗапрос.Заголовки.Вставить("x-starclub-token", StarClubКлючAPI());
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

	HTTPОтвет = StarClubHTTPСоединение().ОтправитьДляОбработки(HTTPЗапрос);
	Возврат HTTPОтвет;
КонецФункции

Функция StarClubGET(ПутьAPI) Экспорт
	HTTPЗапрос = Новый HTTPЗапрос(ПутьAPI);
	HTTPЗапрос.Заголовки.Вставить("x-starclub-token", StarClubКлючAPI());
	HTTPОтвет = StarClubHTTPСоединение().Получить(HTTPЗапрос);
	Возврат HTTPОтвет;
КонецФункции

Функция StarClubПрочитатьJSON(СтрокаJSON) Экспорт
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	Возврат Данные;
КонецФункции

Функция ОчиститиКодКартиStarClub(КодКарты) Экспорт
	Код = Строка(КодКарты);
	Код = СтрЗаменить(Код, " ", "");
	Код = СтрЗаменить(Код, "-", "");
	Код = СтрЗаменить(Код, Символ(160), "");
	Возврат Код;
КонецФункции

Функция StarClubОтриматиПоле(СтруктураДанных, ИмяПоля, ЗначениеПоУмолчанию = "") Экспорт
	Если ТипЗнч(СтруктураДанных) = Тип("Структура") Тогда
		Если СтруктураДанных.Свойство(ИмяПоля) Тогда
			Возврат СтруктураДанных[ИмяПоля];
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Процедура StarClubБезопасноУстановить(Объект, ИмяРеквизита, Значение) Экспорт
	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
		// Якщо в конкретній конфігурації такого реквізиту немає — просто пропускаємо.
	КонецПопытки;
КонецПроцедуры

Функция StarClubЗнайтиТипКартиДляКлієнтів() Экспорт
	// Беремо тип картки з уже існуючих клієнтських карток 1С.
	// У різних конфігураціях реквізит може називатися ТипКарты/ТипКартки.
	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ Выборка.ЭтоГруппа Тогда
				Попытка
					Если ЗначениеЗаполнено(Выборка.ТипКарты) Тогда
						Возврат Выборка.ТипКарты;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubЗнайтиГрупуПокупців() Экспорт
	// У типовій роздрібній конфігурації вже є папка "Картки покупців".
	// Карти Star Club краще створювати всередині неї або всередині нашої підпапки,
	// інакше форма вибору дисконтної карти може їх не показувати через відбір.
	ИменаГрупп = Новый Массив;
	ИменаГрупп.Добавить("Картки покупців");
	ИменаГрупп.Добавить("Карты покупателей");
	ИменаГрупп.Добавить("Карти покупців");

	Для Каждого ИмяГруппы Из ИменаГрупп Цикл
		Попытка
			Группа = Справочники.ИнформационныеКарты.НайтиПоНаименованию(ИмяГруппы, Истина);
			Если ЗначениеЗаполнено(Группа) И НЕ Группа.Пустая() Тогда
				Возврат Группа;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

Функция StarClubЗнайтиГрупуБонуснихКарток(Создавать = Истина) Экспорт
	ИмяГруппы = "Бонусні картки Star Club";

	Попытка
		Группа = Справочники.ИнформационныеКарты.НайтиПоНаименованию(ИмяГруппы, Истина);
		Если ЗначениеЗаполнено(Группа) И НЕ Группа.Пустая() Тогда
			Возврат Группа;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если НЕ Создавать Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		НоваяГруппа = Справочники.ИнформационныеКарты.СоздатьГруппу();
		НоваяГруппа.Наименование = ИмяГруппы;

		// Робимо Star Club підпапкою папки покупців, якщо така існує.
		ГруппаПокупцев = StarClubЗнайтиГрупуПокупців();
		Если ГруппаПокупцев <> Неопределено Тогда
			Попытка
				НоваяГруппа.Родитель = ГруппаПокупцев;
			Исключение
			КонецПопытки;
		КонецЕсли;

		// Якщо в конфігурації є реквізит ТипКарты — проставляємо його.
		ТипКарты = StarClubЗнайтиТипКартиДляКлієнтів();
		Если ТипКарты <> Неопределено Тогда
			StarClubБезопасноУстановить(НоваяГруппа, "ТипКарты", ТипКарты);
			StarClubБезопасноУстановить(НоваяГруппа, "ТипКартки", ТипКарты);
		КонецЕсли;

		НоваяГруппа.Записать();
		Возврат НоваяГруппа.Ссылка;
	Исключение
		Сообщить("Star Club: не вдалося створити папку бонусних карток: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция StarClubЗнайтиКарткуВ1С(КодКарты) Экспорт
	Код = СокрЛП(Строка(КодКарты));
	Если Код = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	КодЧистый = ОчиститиКодКартиStarClub(Код);

	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;

			ТекКод = "";
			Попытка
				ТекКод = Строка(Выборка.КодКарты);
			Исключение
				ТекКод = Строка(Выборка.Наименование);
			КонецПопытки;

			Если СокрЛП(ТекКод) = Код Или ОчиститиКодКартиStarClub(ТекКод) = КодЧистый Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubСтворитиАбоОновитиКарткуВ1С(ДанныеКлиента, ПоказуватиПодробиці = Ложь) Экспорт
	КодКарты = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "card_number", "")));
	Если КодКарты = "" Тогда
		Если ПоказуватиПодробиці Тогда
			Сообщить("Star Club: клієнт без номера картки пропущений.");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Имя = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "name", "")));
	Телефон = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "phone", "")));
	Баланс = Строка(StarClubОтриматиПоле(ДанныеКлиента, "stars_balance", 0));
	Доступно = Строка(StarClubОтриматиПоле(ДанныеКлиента, "available_stars", Баланс));
	Штрихкод = СокрЛП(Строка(StarClubОтриматиПоле(ДанныеКлиента, "barcode", ОчиститиКодКартиStarClub(КодКарты))));

	СсылкаКарты = StarClubЗнайтиКарткуВ1С(КодКарты);
	Если ЗначениеЗаполнено(СсылкаКарты) И СсылкаКарты <> Неопределено Тогда
		ОбъектКарты = СсылкаКарты.ПолучитьОбъект();
		Режим = "оновлено";
	Иначе
		ОбъектКарты = Справочники.ИнформационныеКарты.СоздатьЭлемент();
		Режим = "створено";
	КонецЕсли;

	Группа = StarClubЗнайтиГрупуБонуснихКарток(Истина);
	Если Группа <> Неопределено Тогда
		Попытка
			ОбъектКарты.Родитель = Группа;
		Исключение
			Сообщить("Star Club: не вдалося встановити папку для картки " + КодКарты + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ТипКарты = StarClubЗнайтиТипКартиДляКлієнтів();
	Если ТипКарты <> Неопределено Тогда
		StarClubБезопасноУстановить(ОбъектКарты, "ТипКарты", ТипКарты);
		StarClubБезопасноУстановить(ОбъектКарты, "ТипКартки", ТипКарты);
	КонецЕсли;

	Если Имя = "" Тогда
		Имя = КодКарты;
	КонецЕсли;

	// Важливо: Наименование обов'язково, інакше картка може записатись некоректно.
	ОбъектКарты.Наименование = Имя + " — " + КодКарты;

	StarClubБезопасноУстановить(ОбъектКарты, "КодКарты", КодКарты);
	StarClubБезопасноУстановить(ОбъектКарты, "КодКарти", КодКарты);
	StarClubБезопасноУстановить(ОбъектКарты, "Штрихкод", Штрихкод);
	StarClubБезопасноУстановить(ОбъектКарты, "ШтрихКод", Штрихкод);
	StarClubБезопасноУстановить(ОбъектКарты, "Комментарий", "Star Club; Телефон: " + Телефон + "; Баланс: " + Баланс + " ⭐; Доступно: " + Доступно + " ⭐");
	StarClubБезопасноУстановить(ОбъектКарты, "Телефон", Телефон);
	StarClubБезопасноУстановить(ОбъектКарты, "БалансЗірок", Баланс);
	StarClubБезопасноУстановить(ОбъектКарты, "БалансЗвезд", Баланс);
	StarClubБезопасноУстановить(ОбъектКарты, "ДоступноЗірок", Доступно);
	StarClubБезопасноУстановить(ОбъектКарты, "ДоступноЗвезд", Доступно);

	Попытка
		ОбъектКарты.Записать();
		Если ПоказуватиПодробиці Тогда
			Сообщить("Star Club: картку " + Режим + ": " + Имя + " / " + КодКарты + " / баланс " + Баланс + " ⭐");
		КонецЕсли;
		Возврат ОбъектКарты.Ссылка;
	Исключение
		Сообщить("Star Club: НЕ вдалося записати картку " + КодКарты + ": " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция StarClubМассивМіститьКод(МассивКодов, КодКарты) Экспорт
	КодЧистый = ОчиститиКодКартиStarClub(КодКарты);
	Для Каждого Код Из МассивКодов Цикл
		Если Код = КодЧистый Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция StarClubОчиститиНеактуальніКарткиВ1С(АктуальніКоди) Экспорт
	Удалено = 0;
	Ошибки = 0;

	Группа = StarClubЗнайтиГрупуБонуснихКарток(Ложь);
	Если Группа = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Выборка = Справочники.ИнформационныеКарты.Выбрать(Группа);
		Пока Выборка.Следующий() Цикл
			Если Выборка.ЭтоГруппа Тогда
				Продолжить;
			КонецЕсли;

			КодКарты = "";
			Попытка
				КодКарты = Строка(Выборка.КодКарты);
			Исключение
				КодКарты = Строка(Выборка.Наименование);
			КонецПопытки;

			Если КодКарты = "" Тогда
				Продолжить;
			КонецЕсли;

			Если НЕ StarClubМассивМіститьКод(АктуальніКоди, КодКарты) Тогда
				Попытка
					ОбъектКарты = Выборка.Ссылка.ПолучитьОбъект();
					Попытка
						ОбъектКарты.Удалить();
					Исключение
						ОбъектКарты.УстановитьПометкуУдаления(Истина);
					КонецПопытки;
					Удалено = Удалено + 1;
				Исключение
					Ошибки = Ошибки + 1;
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Star Club: помилка очищення старих карток: " + ОписаниеОшибки());
	КонецПопытки;

	Если Удалено > 0 Или Ошибки > 0 Тогда
		Сообщить("Star Club: очищення папки завершено. Старих карток видалено: " + Строка(Удалено) + ", помилок: " + Строка(Ошибки));
	КонецЕсли;

	Возврат Удалено;
КонецФункции


Функция СинхронізуватиКлієнтівStarClub(Пошук = "", ПоказуватиПодробиці = Ложь) Экспорт
	Попытка
		ПутьAPI = "/api/1c/clients?limit=500";
		Если СокрЛП(Строка(Пошук)) <> "" Тогда
			ПутьAPI = ПутьAPI + "&q=" + КодироватьСтроку(СокрЛП(Строка(Пошук)), СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;

		HTTPОтвет = StarClubGET(ПутьAPI);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
			StarClubDebugЗдача(
		"PREPARE_HTTP_RESPONSE",
		"Код="
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ "; Відповідь="
			+ ОтветСтрока
	);
		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Сообщить("Star Club: помилка синхронізації клієнтів. Код: " + Строка(HTTPОтвет.КодСостояния));
			Возврат 0;
		КонецЕсли;

		Данные = StarClubПрочитатьJSON(ОтветСтрока);
		Клиенты = StarClubОтриматиПоле(Данные, "clients", Новый Массив);
		Количество = 0;
		Ошибки = 0;
		АктуальніКоди = Новый Массив;

		Для Каждого Клиент Из Клиенты Цикл
			КодКлиента = СокрЛП(Строка(StarClubОтриматиПоле(Клиент, "card_number", "")));
			Если КодКлиента <> "" Тогда
				АктуальніКоди.Добавить(ОчиститиКодКартиStarClub(КодКлиента));
			КонецЕсли;

			СсылкаКарты = StarClubСтворитиАбоОновитиКарткуВ1С(Клиент, ПоказуватиПодробиці);
			Если СсылкаКарты <> Неопределено Тогда
				Количество = Количество + 1;
			Иначе
				Ошибки = Ошибки + 1;
			КонецЕсли;
		КонецЦикла;

		Если СокрЛП(Строка(Пошук)) <> "" Тогда
			Сообщить("Star Club: знайдено/оновлено карток за пошуком [" + Строка(Пошук) + "]: " + Строка(Количество));
		Иначе
			УдаленоСтарих = StarClubОчиститиНеактуальніКарткиВ1С(АктуальніКоди);
			Сообщить("Star Club: синхронізація завершена. Актуальних карток записано: " + Строка(Количество) + ", старих прибрано: " + Строка(УдаленоСтарих) + ", помилок: " + Строка(Ошибки));
		КонецЕсли;

		Возврат Количество;
	Исключение
		Сообщить("Star Club: помилка синхронізації клієнтів: " + ОписаниеОшибки());
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ШвидкийПошукКлієнтаStarClub(Пошук) Экспорт

	Пошук =
		СокрЛП(
			Строка(
				Пошук
			)
		);


	Если Пошук = "" Тогда

		Предупреждение(
			"Star Club: введіть телефон або номер картки."
		);

		Возврат Неопределено;

	КонецЕсли;


	Попытка

		КодБезПробелов =
			ОчиститиКодКартиStarClub(
				Пошук
			);


		// Один прямий запит працює і для телефону,
		// і для номера картки.
		ПутьAPI =
			"/api/1c/client/search?card_number="
			+ КодироватьСтроку(
				Пошук,
				СпособКодированияСтроки.КодировкаURL
			)
			+ "&card_token="
			+ КодироватьСтроку(
				КодБезПробелов,
				СпособКодированияСтроки.КодировкаURL
			)
			+ "&phone="
			+ КодироватьСтроку(
				Пошук,
				СпособКодированияСтроки.КодировкаURL
			);


		HTTPОтвет =
			StarClubGET(
				ПутьAPI
			);


		ОтветСтрока =
			HTTPОтвет.
				ПолучитьТелоКакСтроку();


		Если HTTPОтвет.КодСостояния < 200
			Или HTTPОтвет.КодСостояния >= 300
		Тогда

			Предупреждение(
				"Star Club: помилка пошуку клієнта."
				+ Символы.ПС
				+ "HTTP-код: "
				+ Строка(
					HTTPОтвет.КодСостояния
				)
				+ Символы.ПС
				+ ОтветСтрока
			);

			Возврат Неопределено;

		КонецЕсли;


		Данные =
			StarClubПрочитатьJSON(
				ОтветСтрока
			);


		Найден =
			StarClubОтриматиПоле(
				Данные,
				"found",
				Ложь
			);


		Если НЕ Найден Тогда

			Предупреждение(
				"Star Club: клієнта не знайдено."
			);

			Возврат Неопределено;

		КонецЕсли;


		Клиент =
			StarClubОтриматиПоле(
				Данные,
				"client",
				Новый Структура
			);


		// Саме тут картка створюється або оновлюється в 1С
		// та одразу повертається її посилання.
		КартаСсылка =
			StarClubСтворитиАбоОновитиКарткуВ1С(
				Клиент,
				Ложь
			);


		Если КартаСсылка = Неопределено Тогда

			Предупреждение(
				"Star Club: клієнта знайдено, "
				+ "але картку не вдалося записати в 1С."
			);

			Возврат Неопределено;

		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(
			КартаСсылка
		) Тогда

			Предупреждение(
				"Star Club: отримано порожнє посилання на картку."
			);

			Возврат Неопределено;

		КонецЕсли;


		Имя =
			Строка(
				StarClubОтриматиПоле(
					Клиент,
					"name",
					""
				)
			);


		Телефон =
			Строка(
				StarClubОтриматиПоле(
					Клиент,
					"phone",
					""
				)
			);


		НомерКарты =
			Строка(
				StarClubОтриматиПоле(
					Клиент,
					"card_number",
					""
				)
			);


		Баланс =
			Строка(
				StarClubОтриматиПоле(
					Клиент,
					"stars_balance",
					0
				)
			);


		Доступно =
			Строка(
				StarClubОтриматиПоле(
					Клиент,
					"available_stars",
					Баланс
				)
			);


		// Після натискання ОК виконання продовжується,
		// а функція повертає конкретну картку 1С.
		Предупреждение(
			"Клієнт: "
			+ Имя
			+ Символы.ПС
			+ "Тел.: "
			+ Телефон
			+ Символы.ПС
			+ "Карта: "
			+ НомерКарты
			+ Символы.ПС
			+ "Зірки: "
			+ Баланс
			+ " ⭐ (доступно: "
			+ Доступно
			+ " ⭐)"
		);


		Возврат КартаСсылка;


	Исключение

		Предупреждение(
			"Star Club: помилка швидкого пошуку."
			+ Символы.ПС
			+ ОписаниеОшибки()
		);

		Возврат Неопределено;

	КонецПопытки;

КонецФункции
Функция ЗнайтиКлієнтаStarClub(КодКартыИлиТелефон) Экспорт
	Попытка
		Код = СокрЛП(Строка(КодКартыИлиТелефон));
		КодБезПробелов = ОчиститиКодКартиStarClub(Код);
		ПутьAPI = "/api/1c/client/search?card_number=" + КодироватьСтроку(Код, СпособКодированияСтроки.КодировкаURL)
			+ "&card_token=" + КодироватьСтроку(КодБезПробелов, СпособКодированияСтроки.КодировкаURL)
			+ "&phone=" + КодироватьСтроку(Код, СпособКодированияСтроки.КодировкаURL);

		HTTPОтвет = StarClubGET(ПутьAPI);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Данные = StarClubПрочитатьJSON(ОтветСтрока);
			Если StarClubОтриматиПоле(Данные, "found", Ложь) Тогда
				Клиент = StarClubОтриматиПоле(Данные, "client", Новый Структура);
				Имя = Строка(StarClubОтриматиПоле(Клиент, "name", ""));
				Телефон = Строка(StarClubОтриматиПоле(Клиент, "phone", ""));
				Карта = Строка(StarClubОтриматиПоле(Клиент, "card_number", Код));
				Баланс = Строка(StarClubОтриматиПоле(Клиент, "stars_balance", 0));
				Доступно = Строка(StarClubОтриматиПоле(Клиент, "available_stars", Баланс));
				Предупреждение("Клієнт: " + Имя + Символы.ПС + "Тел.: " + Телефон + Символы.ПС + "Карта: " + Карта + Символы.ПС + "Зірки: " + Баланс + " ⭐ (доступно: " + Доступно + " ⭐)");
				Возврат ОтветСтрока;
			Иначе
				Сообщить("Star Club: клієнта не знайдено за кодом: " + Код);
				Возврат ОтветСтрока;
			КонецЕсли;
		Иначе
			Сообщить("Star Club: помилка пошуку клієнта. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка пошуку клієнта: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПоказатиБалансКарткиStarClub(КартаСсылка) Экспорт
	Если НЕ ЗначениеЗаполнено(КартаСсылка) Тогда
		Сообщить("Star Club: спочатку виберіть дисконтну картку.");
		Возврат "";
	КонецЕсли;
	Попытка
		КодКарты = Строка(КартаСсылка.КодКарты);
	Исключение
		КодКарты = Строка(КартаСсылка);
	КонецПопытки;
	Возврат ЗнайтиКлієнтаStarClub(КодКарты);
КонецФункции

Функция ПеревіритиКодТовараЗаЗірки(КодQR) Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/validate", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			ДанныеОтвета = StarClubПрочитатьJSON(ОтветСтрока);
			QR = StarClubОтриматиПоле(ДанныеОтвета, "qr", Новый Структура);
			Клиент = StarClubОтриматиПоле(QR, "client", Новый Структура);
			Товар = Строка(StarClubОтриматиПоле(QR, "product_name", ""));
			КодТовара1С = Строка(StarClubОтриматиПоле(QR, "product_external_id", ""));
			Кількість = Строка(StarClubОтриматиПоле(QR, "qty", 1));
			ЦінаГрн = Строка(StarClubОтриматиПоле(QR, "price_uah", 0));
			Зірки = Строка(StarClubОтриматиПоле(QR, "stars_to_spend", 0));
			Статус = Строка(StarClubОтриматиПоле(ДанныеОтвета, "status", "reserved"));
			Карта = Строка(StarClubОтриматиПоле(Клиент, "card_number", ""));
			Телефон = Строка(StarClubОтриматиПоле(Клиент, "phone", ""));
			Баланс = Строка(StarClubОтриматиПоле(Клиент, "balance", ""));
			Текст = "Star Club: код товару дійсний" + Символы.ПС
				+ "Статус: " + Статус + Символы.ПС
				+ "Товар: " + Товар + Символы.ПС
				+ "Код товару 1С: " + КодТовара1С + Символы.ПС
				+ "Кількість: " + Кількість + Символы.ПС
				+ "Ціна в грн: " + ЦінаГрн + Символы.ПС
				+ "Ціна в зірках: " + Зірки + " ⭐" + Символы.ПС
				+ "Карта: " + Карта + Символы.ПС
				+ "Телефон: " + Телефон + Символы.ПС
				+ "Баланс до списання: " + Баланс + " ⭐";
			Предупреждение(Текст);
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код недійсний. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка перевірки коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПідтвердитиКодТовараЗаЗірки(КодQR, НомерЧека, Магазин = "1c") Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));
		Данные.Вставить("receipt_id", Строка(НомерЧека));
		StarClubДодатиМагазинВДані(Данные, Магазин);

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/finalize", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Сообщить("Star Club: код використано, зірки списано.");
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код НЕ використано. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка підтвердження коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СкасуватиКодТовараЗаЗірки(КодQR, Магазин = "1c") Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));
		StarClubДодатиМагазинВДані(Данные, Магазин);

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/cancel", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Предупреждение("Star Club" + Символы.ПС + "Код скасовано. Зірки знову доступні клієнту." + Символы.ПС + "Код: " + Строка(КодQR));
			Возврат ОтветСтрока;
		Иначе
			Сообщить("Star Club: код не скасовано. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат "";
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка скасування коду: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ЗапитатиТаПеревіритиКодТовараЗаЗірки() Экспорт
	КодQR = "";
	Если ВвестиСтроку(КодQR, "Введіть або відскануйте код товару Star Club", 100) Тогда
		Возврат ПеревіритиКодТовараЗаЗірки(КодQR);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЗапитатиТаПідтвердитиКодТовараЗаЗірки(НомерЧека = "") Экспорт
	КодQR = "";
	Если НЕ ВвестиСтроку(КодQR, "Введіть код товару Star Club для списання", 100) Тогда
		Возврат "";
	КонецЕсли;
	Если СокрЛП(Строка(НомерЧека)) = "" Тогда
		НомерЧека = "MANUAL-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	Возврат ПідтвердитиКодТовараЗаЗірки(КодQR, НомерЧека);
КонецФункции

Функция ЗапитатиТаСкасуватиКодТовараЗаЗірки() Экспорт
	КодQR = "";
	Если ВвестиСтроку(КодQR, "Введіть код товару Star Club для скасування", 100) Тогда
		Возврат СкасуватиКодТовараЗаЗірки(КодQR);
	КонецЕсли;
	Возврат "";
КонецФункции



// ===== КОДИ ТОВАРІВ І ГРУП 1С =====
// У цій базі і товар, і група мають коди одного формату, наприклад ЦБ000004323.
// Тому код не визначає тип об'єкта: type=product/group передається окремо.

Функция StarClubНормалізуватиКод1С(Код1С) Экспорт
	Результат = ВРег(СокрЛП(Строка(Код1С)));
	Результат = СтрЗаменить(Результат, " ", "");
	Возврат Результат;
КонецФункции

Функция StarClubКодГрупиНоменклатури(
	Номенклатура
) Экспорт

	Попытка

		Группа =
			Номенклатура.Родитель;

		Если ЗначениеЗаполнено(
			Группа
		) Тогда

			Возврат
				StarClubНормалізуватиКод1С(
					Группа.Код
				);

		КонецЕсли;

	Исключение
	КонецПопытки;


	Возврат "";

КонецФункции
Функция StarClubШляхКодівГруп(
	Номенклатура
) Экспорт

	Результат =
		Новый Массив;


	Попытка

		Группа =
			Номенклатура.Родитель;

	Исключение

		Возврат Результат;

	КонецПопытки;


	Пока ЗначениеЗаполнено(
		Группа
	) Цикл


		Попытка

			КодГруппы =
				StarClubНормалізуватиКод1С(
					Группа.Код
				);

			Если КодГруппы <> "" Тогда

				Результат.Добавить(
					КодГруппы
				);

			КонецЕсли;

		Исключение
		КонецПопытки;


		Попытка

			Если НЕ ЗначениеЗаполнено(
				Группа.Родитель
			) Тогда

				Прервать;

			КонецЕсли;


			Группа =
				Группа.Родитель;

		Исключение

			Прервать;

		КонецПопытки;

	КонецЦикла;


	Возврат Результат;

КонецФункции
Процедура StarClubДодатиКодиТоваруІГрупи(
	ТоварJSON,
	Номенклатура
) Экспорт


	КодТовара =
		StarClubНормалізуватиКод1С(
			Номенклатура.Код
		);


	ТоварJSON.Вставить(
		"product_id",
		КодТовара
	);

	ТоварJSON.Вставить(
		"external_product_id",
		КодТовара
	);


	КодГруппы =
		StarClubКодГрупиНоменклатури(
			Номенклатура
		);


	Если КодГруппы <> "" Тогда

		ТоварJSON.Вставить(
			"group_external_id",
			КодГруппы
		);

	КонецЕсли;


	Попытка

		Группа =
			Номенклатура.Родитель;


		Если ЗначениеЗаполнено(
			Группа
		) Тогда

			ТоварJSON.Вставить(
				"group_name",
				Строка(
					Группа.Наименование
				)
			);

			ТоварJSON.Вставить(
				"category",
				Строка(
					Группа.Наименование
				)
			);

		Иначе

			ТоварJSON.Вставить(
				"category",
				""
			);

		КонецЕсли;

	Исключение

		ТоварJSON.Вставить(
			"category",
			""
		);

	КонецПопытки;


	ТоварJSON.Вставить(
		"group_path",
		StarClubШляхКодівГруп(
			Номенклатура
		)
	);

КонецПроцедуры

// ===== СИНХРОНІЗАЦІЯ ТОВАРІВ, МАГАЗИНІВ І ЦІН У STAR CLUB =====
// Цей блок призначений саме для наданої конфігурації 1С.
// Джерело цін: РегистрСведений.ЦеныНоменклатурыМагазинов.

Функция StarClubКодМагазину(Магазин) Экспорт
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда
		Возврат "";
	КонецЕсли;

	КодМагазина = "";
	Попытка
		КодМагазина = StarClubНормалізуватиКод1С(Магазин.Код);
	Исключение
	КонецПопытки;

	Если КодМагазина = "" Тогда
		Попытка
			КодМагазина = StarClubНормалізуватиКод1С(Магазин.УникальныйИдентификатор());
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат КодМагазина;
КонецФункции

Функция StarClubНазваМагазину(Магазин) Экспорт
	НазваниеМагазина = "";
	Попытка
		НазваниеМагазина = СокрЛП(Строка(Магазин.Наименование));
	Исключение
	КонецПопытки;

	Если НазваниеМагазина = "" Тогда
		НазваниеМагазина = СокрЛП(Строка(Магазин));
	КонецЕсли;

	Возврат НазваниеМагазина;
КонецФункции
Процедура StarClubДодатиМагазинВДані(Данные, Магазин) Экспорт
	КодМагазина = StarClubКодМагазину(Магазин);
	НазваниеМагазина = StarClubНазваМагазину(Магазин);
	Если КодМагазина = "" Тогда
		КодМагазина = СокрЛП(Строка(Магазин));
	КонецЕсли;

	Данные.Вставить("store_id", КодМагазина);
	Данные.Вставить("store_external_id", КодМагазина);
	Данные.Вставить("store_name", НазваниеМагазина);
КонецПроцедуры
Функция StarClubНормалізуватиШтрихкод1С(ЗначениеШтрихкода) Экспорт
	Результат = СокрЛП(Строка(ЗначениеШтрихкода));
	Результат = СтрЗаменить(Результат, " ", "");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	Возврат Результат;
КонецФункции

Функция StarClubЗнайтиПолеНоменклатуриВРегистре(МетаРегистра) Экспорт
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("Номенклатура");
	ИменаПолей.Добавить("Товар");
	ИменаПолей.Добавить("Владелец");
	ИменаПолей.Добавить("НоменклатураСсылка");
	ИменаПолей.Добавить("Объект");

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если МетаРегистра.Измерения.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		Если МетаРегистра.Ресурсы.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		Если МетаРегистра.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
	КонецЦикла;

	// Якщо поле називається нестандартно — визначаємо його за типом
	// СправочникСсылка.Номенклатура. Це покриває конфігурації, де замість
	// "Номенклатура" використано "Владелец", "Объект" або власну назву.
	Попытка
		ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");

		Для Каждого Поле Из МетаРегистра.Измерения Цикл
			Попытка
				Если Поле.Тип.СодержитТип(ТипНоменклатуры) Тогда
					Возврат Поле.Имя;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;

		Для Каждого Поле Из МетаРегистра.Ресурсы Цикл
			Попытка
				Если Поле.Тип.СодержитТип(ТипНоменклатуры) Тогда
					Возврат Поле.Имя;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;

		Для Каждого Поле Из МетаРегистра.Реквизиты Цикл
			Попытка
				Если Поле.Тип.СодержитТип(ТипНоменклатуры) Тогда
					Возврат Поле.Имя;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат "";
КонецФункции

Функция StarClubЗнайтиПолеШтрихкодаВРегистре(МетаРегистра) Экспорт
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("Штрихкод");
	ИменаПолей.Добавить("ШтрихКод");
	ИменаПолей.Добавить("Barcode");
	ИменаПолей.Добавить("EAN");
	ИменаПолей.Добавить("EAN13");
	ИменаПолей.Добавить("GTIN");

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если МетаРегистра.Измерения.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		Если МетаРегистра.Ресурсы.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
		Если МетаРегистра.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат ИмяПоля;
		КонецЕсли;
	КонецЦикла;

	// Додатковий пошук за частиною імені поля.
	Для Каждого Поле Из МетаРегистра.Измерения Цикл
		ИмяВерх = ВРег(Поле.Имя);
		Если СтрНайти(ИмяВерх, "ШТРИХ") > 0
			Или СтрНайти(ИмяВерх, "BARCODE") > 0
			Или СтрНайти(ИмяВерх, "EAN") > 0
			Или СтрНайти(ИмяВерх, "GTIN") > 0 Тогда
			Возврат Поле.Имя;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Поле Из МетаРегистра.Ресурсы Цикл
		ИмяВерх = ВРег(Поле.Имя);
		Если СтрНайти(ИмяВерх, "ШТРИХ") > 0
			Или СтрНайти(ИмяВерх, "BARCODE") > 0
			Или СтрНайти(ИмяВерх, "EAN") > 0
			Или СтрНайти(ИмяВерх, "GTIN") > 0 Тогда
			Возврат Поле.Имя;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Поле Из МетаРегистра.Реквизиты Цикл
		ИмяВерх = ВРег(Поле.Имя);
		Если СтрНайти(ИмяВерх, "ШТРИХ") > 0
			Или СтрНайти(ИмяВерх, "BARCODE") > 0
			Или СтрНайти(ИмяВерх, "EAN") > 0
			Или СтрНайти(ИмяВерх, "GTIN") > 0 Тогда
			Возврат Поле.Имя;
		КонецЕсли;
	КонецЦикла;

	Возврат "";
КонецФункции

Процедура StarClubДодатиШтрихкодУКарту(КартаШтрихкодов, Номенклатура, ЗначениеШтрихкода) Экспорт
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;

	Штрихкод = StarClubНормалізуватиШтрихкод1С(ЗначениеШтрихкода);
	Если Штрихкод = "" Тогда
		Возврат;
	КонецЕсли;

	МассивШтрихкодов = КартаШтрихкодов.Получить(Номенклатура);
	Если МассивШтрихкодов = Неопределено Тогда
		МассивШтрихкодов = Новый Массив;
		КартаШтрихкодов.Вставить(Номенклатура, МассивШтрихкодов);
	КонецЕсли;

	Если МассивШтрихкодов.Найти(Штрихкод) = Неопределено Тогда
		МассивШтрихкодов.Добавить(Штрихкод);
	КонецЕсли;
КонецПроцедуры

Функция StarClubОтриматиКартуШтрихкодівНоменклатури() Экспорт
	КартаШтрихкодов = Новый Соответствие;
	Источники = Новый Массив;
	ОшибкиИсточников = Новый Массив;
	ВсегоШтрихкодов = 0;

	// Не прив'язуємось до однієї назви регістру. Переглядаємо метадані й
	// беремо тільки ті регістри, де одночасно є поле номенклатури та поле
	// штрих-коду. Це працює і для "ШтрихкодыНоменклатуры", і для варіантів
	// з полями "Владелец"/"Товар", а також для змінених конфігурацій.
	Для Каждого МетаРегистра Из Метаданные.РегистрыСведений Цикл
		ПолеНоменклатуры = StarClubЗнайтиПолеНоменклатуриВРегистре(МетаРегистра);
		Если ПолеНоменклатуры = "" Тогда
			Продолжить;
		КонецЕсли;

		ПолеШтрихкода = StarClubЗнайтиПолеШтрихкодаВРегистре(МетаРегистра);
		Если ПолеШтрихкода = "" Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ЗапросШтрихкодов = Новый Запрос;
			ЗапросШтрихкодов.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ "
				+ "Рег." + ПолеНоменклатуры + " КАК Номенклатура, "
				+ "Рег." + ПолеШтрихкода + " КАК Штрихкод "
				+ "ИЗ РегистрСведений." + МетаРегистра.Имя + " КАК Рег";

			ВыборкаШтрихкодов = ЗапросШтрихкодов.Выполнить().Выбрать();
			НайденоВИсточнике = 0;

			Пока ВыборкаШтрихкодов.Следующий() Цикл
				ДоДобавления = КартаШтрихкодов.Количество();
				НоменклатураСтроки = ВыборкаШтрихкодов.Номенклатура;
				ШтрихкодСтроки = StarClubНормалізуватиШтрихкод1С(ВыборкаШтрихкодов.Штрихкод);

				Если ЗначениеЗаполнено(НоменклатураСтроки) И ШтрихкодСтроки <> "" Тогда
					МассивДо = КартаШтрихкодов.Получить(НоменклатураСтроки);
					КоличествоДо = 0;
					Если МассивДо <> Неопределено Тогда
						КоличествоДо = МассивДо.Количество();
					КонецЕсли;

					StarClubДодатиШтрихкодУКарту(
						КартаШтрихкодов,
						НоменклатураСтроки,
						ШтрихкодСтроки
					);

					МассивПосле = КартаШтрихкодов.Получить(НоменклатураСтроки);
					Если МассивПосле <> Неопределено
						И МассивПосле.Количество() > КоличествоДо Тогда
						НайденоВИсточнике = НайденоВИсточнике + 1;
						ВсегоШтрихкодов = ВсегоШтрихкодов + 1;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Если НайденоВИсточнике > 0 Тогда
				Источники.Добавить(
					МетаРегистра.Имя
					+ "." + ПолеШтрихкода
					+ " → " + ПолеНоменклатуры
					+ " (" + Строка(НайденоВИсточнике) + ")"
				);
			КонецЕсли;
		Исключение
			ОшибкиИсточников.Добавить(
				МетаРегистра.Имя + ": " + ОписаниеОшибки()
			);
		КонецПопытки;
	КонецЦикла;

	// Деякі конфігурації зберігають один штрих-код прямо в реквізиті
	// довідника Номенклатура. Якщо такий реквізит існує — також забираємо його.
	МетаНоменклатуры = Метаданные.Справочники.Найти("Номенклатура");
	Если МетаНоменклатуры <> Неопределено Тогда
		ИмяРеквизитаШтрихкода = "";

		КандидатыРеквизитов = Новый Массив;
		КандидатыРеквизитов.Добавить("Штрихкод");
		КандидатыРеквизитов.Добавить("ШтрихКод");
		КандидатыРеквизитов.Добавить("Barcode");
		КандидатыРеквизитов.Добавить("EAN");
		КандидатыРеквизитов.Добавить("EAN13");
		КандидатыРеквизитов.Добавить("GTIN");

		Для Каждого ИмяРеквизита Из КандидатыРеквизитов Цикл
			Если МетаНоменклатуры.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
				ИмяРеквизитаШтрихкода = ИмяРеквизита;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ИмяРеквизитаШтрихкода <> "" Тогда
			Попытка
				ЗапросШтрихкодов = Новый Запрос;
				ЗапросШтрихкодов.Текст =
					"ВЫБРАТЬ "
					+ "Ном.Ссылка КАК Номенклатура, "
					+ "Ном." + ИмяРеквизитаШтрихкода + " КАК Штрихкод "
					+ "ИЗ Справочник.Номенклатура КАК Ном "
					+ "ГДЕ НЕ Ном.ЭтоГруппа";

				ВыборкаШтрихкодов = ЗапросШтрихкодов.Выполнить().Выбрать();
				НайденоВДовіднику = 0;

				Пока ВыборкаШтрихкодов.Следующий() Цикл
					ШтрихкодСтроки = StarClubНормалізуватиШтрихкод1С(
						ВыборкаШтрихкодов.Штрихкод
					);
					Если ШтрихкодСтроки = "" Тогда
						Продолжить;
					КонецЕсли;

					МассивДо = КартаШтрихкодов.Получить(
						ВыборкаШтрихкодов.Номенклатура
					);
					КоличествоДо = 0;
					Если МассивДо <> Неопределено Тогда
						КоличествоДо = МассивДо.Количество();
					КонецЕсли;

					StarClubДодатиШтрихкодУКарту(
						КартаШтрихкодов,
						ВыборкаШтрихкодов.Номенклатура,
						ШтрихкодСтроки
					);

					МассивПосле = КартаШтрихкодов.Получить(
						ВыборкаШтрихкодов.Номенклатура
					);
					Если МассивПосле <> Неопределено
						И МассивПосле.Количество() > КоличествоДо Тогда
						НайденоВДовіднику = НайденоВДовіднику + 1;
						ВсегоШтрихкодов = ВсегоШтрихкодов + 1;
					КонецЕсли;
				КонецЦикла;

				Если НайденоВДовіднику > 0 Тогда
					Источники.Добавить(
						"Справочник.Номенклатура."
						+ ИмяРеквизитаШтрихкода
						+ " (" + Строка(НайденоВДовіднику) + ")"
					);
				КонецЕсли;
			Исключение
				ОшибкиИсточников.Добавить(
					"Справочник.Номенклатура."
					+ ИмяРеквизитаШтрихкода
					+ ": " + ОписаниеОшибки()
				);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Если ВсегоШтрихкодов = 0 Тогда
		ТекстОшибки =
			"Star Club: у 1С не вдалося прочитати жодного штрих-коду номенклатури. "
			+ "Синхронізацію зупинено, щоб не відправляти каталог без barcode/barcodes.";

		Если ОшибкиИсточников.Количество() > 0 Тогда
			ТекстОшибки = ТекстОшибки
				+ " Перша технічна помилка джерела: "
				+ Строка(ОшибкиИсточников[0]);
		КонецЕсли;

		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	ТекстИсточников = "";
	Для Каждого Источник Из Источники Цикл
		Если ТекстИсточников <> "" Тогда
			ТекстИсточников = ТекстИсточников + "; ";
		КонецЕсли;
		ТекстИсточников = ТекстИсточников + Строка(Источник);
	КонецЦикла;

	Сообщить(
		"Star Club: штрих-коди 1С прочитано. Унікальних кодів: "
		+ Строка(ВсегоШтрихкодов)
		+ ", товарів зі штрих-кодом: "
		+ Строка(КартаШтрихкодов.Количество())
		+ ". Джерело: " + ТекстИсточников
	);

	Возврат Новый Структура(
		"Карта,Количество,Источники",
		КартаШтрихкодов,
		ВсегоШтрихкодов,
		ТекстИсточников
	);
КонецФункции

Функция StarClubОтриматиЦіниМагазину(МагазинДляЦін, ДатаЦін = Неопределено) Экспорт
	Если НЕ ЗначениеЗаполнено(МагазинДляЦін) Тогда
		ВызватьИсключение "Star Club: не вибрано магазин для отримання цін";
	КонецЕсли;

	Если ДатаЦін = Неопределено Тогда
		ДатаЦін = КонецДня(ТекущаяДата());
	КонецЕсли;

	ЦеныПоНоменклатуре = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| Цены.Номенклатура КАК Номенклатура,
		| МИНИМУМ(Цены.Цена) КАК Цена
		|ИЗ
		| РегистрСведений.ЦеныНоменклатурыМагазинов.СрезПоследних(
		|  &ДатаЦен,
		|  Магазин = &Магазин) КАК Цены
		|ГДЕ
		| Цены.Цена > 0
		|СГРУППИРОВАТЬ ПО
		| Цены.Номенклатура";

	Запрос.УстановитьПараметр("ДатаЦен", ДатаЦін);
	Запрос.УстановитьПараметр("Магазин", МагазинДляЦін);

	Попытка
		ВыборкаЦен = Запрос.Выполнить().Выбрать();
		Пока ВыборкаЦен.Следующий() Цикл
			Цена = Число(ВыборкаЦен.Цена);
			Если Цена > 0 Тогда
				ЦеныПоНоменклатуре.Вставить(ВыборкаЦен.Номенклатура, Цена);
			КонецЕсли;
		КонецЦикла;
	Исключение
		ВызватьИсключение "Star Club: не вдалося прочитати ЦеныНоменклатурыМагазинов для магазину '"
			+ StarClubНазваМагазину(МагазинДляЦін) + "': " + ОписаниеОшибки();
	КонецПопытки;

	Если ЦеныПоНоменклатуре.Количество() = 0 Тогда
		ВызватьИсключение "Star Club: у регістрі ЦеныНоменклатурыМагазинов немає додатних цін для магазину '"
			+ StarClubНазваМагазину(МагазинДляЦін) + "'. Синхронізацію цього магазину зупинено, щоб не записати нулі.";
	КонецЕсли;

	Возврат ЦеныПоНоменклатуре;
КонецФункции

Функция StarClubВідправитиПакетНоменклатури(ПакетТоварів, Магазин) Экспорт
	Если ПакетТоварів.Количество() = 0 Тогда
		Возврат Новый Структура("Товары,Цены,НулевыеЦены,Штрихкоды", 0, 0, 0, 0);
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("store_external_id", StarClubКодМагазину(Магазин));
	Данные.Вставить("store_name", StarClubНазваМагазину(Магазин));
	Данные.Вставить("products", ПакетТоварів);

	HTTPОтвет = StarClubPOST("/api/1c/products/sync", Данные);
	ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

	Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
		ВызватьИсключение "Star Club: помилка синхронізації товарів. HTTP "
			+ Строка(HTTPОтвет.КодСостояния) + ": " + ОтветСтрока;
	КонецЕсли;

	Ответ = StarClubПрочитатьJSON(ОтветСтрока);
	Возврат Новый Структура(
		"Товары,Цены,НулевыеЦены,Штрихкоды",
		Число(StarClubОтриматиПоле(Ответ, "synced", 0)),
		Число(StarClubОтриматиПоле(Ответ, "prices_synced", 0)),
		Число(StarClubОтриматиПоле(Ответ, "zero_prices", 0)),
		Число(StarClubОтриматиПоле(Ответ, "barcodes_synced", 0))
	);
КонецФункции



// ===== ФОТО ТОВАРІВ 1С -> STAR CLUB =====
// Додатковий блок: читає фото з картки номенклатури та передає його на backend.
// Існуючі товари, ціни, штрих-коди, чеки, клієнти та інша логіка не змінюються.

Функция StarClubДвоичныеДанныеФотоИзЗначения(ЗначениеФото, Глубина = 0) Экспорт
	Если Глубина > 4 Или ЗначениеФото = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если ТипЗнч(ЗначениеФото) = Тип("ДвоичныеДанные") Тогда
			Возврат ЗначениеФото;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// ХранилищеЗначения та подібні обгортки.
	Попытка
		ВнутреннееЗначение = ЗначениеФото.Получить();
		Данные = StarClubДвоичныеДанныеФотоИзЗначения(ВнутреннееЗначение, Глубина + 1);
		Если Данные <> Неопределено Тогда
			Возврат Данные;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Картинка та об'єкти, які можуть віддати двійкові дані напряму.
	Попытка
		Данные = ЗначениеФото.ПолучитьДвоичныеДанные();
		Если Данные <> Неопределено Тогда
			Возврат Данные;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// Якщо реквізит є посиланням на приєднаний файл — читаємо сам об'єкт файла.
	Попытка
		ОбъектФото = ЗначениеФото.ПолучитьОбъект();
		Данные = StarClubДвоичныеДанныеФотоИзОбъекта(ОбъектФото, Глубина + 1);
		Если Данные <> Неопределено Тогда
			Возврат Данные;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubДвоичныеДанныеФотоИзОбъекта(ОбъектФото, Глубина = 0) Экспорт
	Если Глубина > 4 Или ОбъектФото = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ОсновноеИзображение");
	ИменаПолей.Добавить("ОсновнаяКартинка");
	ИменаПолей.Добавить("Изображение");
	ИменаПолей.Добавить("Картинка");
	ИменаПолей.Добавить("Фото");
	ИменаПолей.Добавить("Фотография");
	ИменаПолей.Добавить("ФайлКартинки");
	ИменаПолей.Добавить("ФайлИзображения");
	ИменаПолей.Добавить("ПрисоединенныйФайл");
	ИменаПолей.Добавить("ОсновнойФайл");
	ИменаПолей.Добавить("Хранилище");
	ИменаПолей.Добавить("ХранилищеЗначения");
	ИменаПолей.Добавить("ДанныеФайла");
	ИменаПолей.Добавить("ДвоичныеДанные");
	ИменаПолей.Добавить("Содержимое");
	ИменаПолей.Добавить("Данные");

	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Попытка
			ЗначениеПоля = ОбъектФото[ИмяПоля];
			Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
				Данные = StarClubДвоичныеДанныеФотоИзЗначения(ЗначениеПоля, Глубина + 1);
				Если Данные <> Неопределено Тогда
					Возврат Данные;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	// Додатково переглядаємо реквізити з назвами Фото/Картинка/Изображение.
	Попытка
		МетаОбъекта = ОбъектФото.Метаданные();
		Для Каждого Реквизит Из МетаОбъекта.Реквизиты Цикл
			ИмяНиж = НРег(Строка(Реквизит.Имя));
			Если СтрНайти(ИмяНиж, "фото") = 0
				И СтрНайти(ИмяНиж, "картин") = 0
				И СтрНайти(ИмяНиж, "изображ") = 0
				И СтрНайти(ИмяНиж, "image") = 0
				И СтрНайти(ИмяНиж, "picture") = 0 Тогда
				Продолжить;
			КонецЕсли;

			Попытка
				ЗначениеПоля = ОбъектФото[Реквизит.Имя];
				Если ЗначениеЗаполнено(ЗначениеПоля) Тогда
					Данные = StarClubДвоичныеДанныеФотоИзЗначения(ЗначениеПоля, Глубина + 1);
					Если Данные <> Неопределено Тогда
						Возврат Данные;
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Функция StarClubОтриматиФотоНоменклатуриBase64(Номенклатура) Экспорт
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		ОбъектНоменклатуры = Номенклатура.ПолучитьОбъект();
		ДвоичныеДанныеФото = StarClubДвоичныеДанныеФотоИзОбъекта(ОбъектНоменклатуры, 0);
		Если ДвоичныеДанныеФото = Неопределено Тогда
			Возврат "";
		КонецЕсли;

		СтрокаBase64 = Base64Строка(ДвоичныеДанныеФото);
		Если СтрДлина(СтрокаBase64) > 14000000 Тогда
			Сообщить("Star Club: фото товару '" + Строка(Номенклатура) + "' пропущено — файл завеликий (понад 10 МБ).");
			Возврат "";
		КонецЕсли;
		Возврат СтрокаBase64;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция StarClubВідправитиФотоТовару(КодТовара, ФотоBase64) Экспорт
	Если СокрЛП(Строка(КодТовара)) = "" Или СокрЛП(Строка(ФотоBase64)) = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("external_id", StarClubНормалізуватиКод1С(КодТовара));
	Данные.Вставить("image_base64", ФотоBase64);

	Попытка
		HTTPОтвет = StarClubPOST("/api/1c/products/image", Данные);
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Ложь;
КонецФункции

Процедура СинхронізуватиФотоНоменклатуриStarClub() Экспорт
	ПереданоФото = 0;
	ОшибкиФото = 0;

	ВыборкаФото = Справочники.Номенклатура.Выбрать();
	Пока ВыборкаФото.Следующий() Цикл
		Если ВыборкаФото.ЭтоГруппа Или ВыборкаФото.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		КодТовараФото = StarClubНормалізуватиКод1С(ВыборкаФото.Код);
		Если КодТовараФото = "" Тогда
			Продолжить;
		КонецЕсли;

		ФотоBase64 = StarClubОтриматиФотоНоменклатуриBase64(ВыборкаФото.Ссылка);
		Если ФотоBase64 = "" Тогда
			Продолжить;
		КонецЕсли;

		Если StarClubВідправитиФотоТовару(КодТовараФото, ФотоBase64) Тогда
			ПереданоФото = ПереданоФото + 1;
		Иначе
			ОшибкиФото = ОшибкиФото + 1;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Star Club: синхронізацію фото завершено. Передано: "
		+ Строка(ПереданоФото) + ", помилок: " + Строка(ОшибкиФото));
КонецПроцедуры

Процедура СинхронізуватиНоменклатуруStarClub(
	МагазинДляЦін,
	РазмерПакета = 200,
	СинхронізуватиФото = Истина
) Экспорт
	Если НЕ ЗначениеЗаполнено(МагазинДляЦін) Тогда
		ВызватьИсключение "Star Club: не вибрано магазин для синхронізації";
	КонецЕсли;

	Если РазмерПакета < 1 Тогда
		РазмерПакета = 200;
	КонецЕсли;

	КодМагазина = StarClubКодМагазину(МагазинДляЦін);
	НазваниеМагазина = StarClubНазваМагазину(МагазинДляЦін);
	Если КодМагазина = "" Тогда
		ВызватьИсключение "Star Club: у магазину '" + НазваниеМагазина + "' не заповнений код";
	КонецЕсли;

	ЦеныМагазина = StarClubОтриматиЦіниМагазину(МагазинДляЦін);

	// Штрих-коди читаємо один раз на початку синхронізації, а не окремим
	// запитом для кожного з тисяч товарів.
	ДанныеШтрихкодов = StarClubОтриматиКартуШтрихкодівНоменклатури();
	КартаШтрихкодов = ДанныеШтрихкодов.Карта;

	Пакет = Новый Массив;
	ВсегоТоваров = 0;
	ВсегоЦен = 0;
	ВсегоНулевыхЦен = 0;
	ВсегоШтрихкодов = 0;
	ТоваровСоШтрихкодами = 0;

	Выборка = Справочники.Номенклатура.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		КодТовара = StarClubНормалізуватиКод1С(Выборка.Код);
		Если КодТовара = "" Тогда
			Продолжить;
		КонецЕсли;

		Товар = Новый Структура;
		Товар.Вставить("external_id", КодТовара);
		Товар.Вставить("name", Строка(Выборка.Наименование));
		Товар.Вставить("store_external_id", КодМагазина);
		Товар.Вставить("store_id", КодМагазина);
		Товар.Вставить("store_name", НазваниеМагазина);

		ШтрихкодыТовара = КартаШтрихкодов.Получить(Выборка.Ссылка);
		Если ШтрихкодыТовара <> Неопределено
			И ШтрихкодыТовара.Количество() > 0 Тогда
			Товар.Вставить("barcodes", ШтрихкодыТовара);
			Товар.Вставить("barcode", ШтрихкодыТовара[0]);
			ТоваровСоШтрихкодами = ТоваровСоШтрихкодами + 1;
		КонецЕсли;

		Группа = Выборка.Родитель;
		Если ЗначениеЗаполнено(Группа) Тогда
			Товар.Вставить("group_external_id", StarClubНормалізуватиКод1С(Группа.Код));
			Товар.Вставить("group_name", Строка(Группа.Наименование));
			Товар.Вставить("category", Строка(Группа.Наименование));
		Иначе
			Товар.Вставить("group_external_id", "");
			Товар.Вставить("group_name", "");
			Товар.Вставить("category", "");
		КонецЕсли;

		Товар.Вставить("group_path", StarClubШляхКодівГруп(Выборка.Ссылка));

		Цена = ЦеныМагазина.Получить(Выборка.Ссылка);
		Если Цена = Неопределено Тогда
			Цена = 0;
		КонецЕсли;
		Товар.Вставить("price_cents", Окр(Число(Цена) * 100, 0));

		Пакет.Добавить(Товар);
		Если Пакет.Количество() >= РазмерПакета Тогда
			РезультатПакета = StarClubВідправитиПакетНоменклатури(Пакет, МагазинДляЦін);
			ВсегоТоваров = ВсегоТоваров + РезультатПакета.Товары;
			ВсегоЦен = ВсегоЦен + РезультатПакета.Цены;
			ВсегоНулевыхЦен = ВсегоНулевыхЦен + РезультатПакета.НулевыеЦены;
			ВсегоШтрихкодов = ВсегоШтрихкодов + РезультатПакета.Штрихкоды;
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Если Пакет.Количество() > 0 Тогда
		РезультатПакета = StarClubВідправитиПакетНоменклатури(Пакет, МагазинДляЦін);
		ВсегоТоваров = ВсегоТоваров + РезультатПакета.Товары;
		ВсегоЦен = ВсегоЦен + РезультатПакета.Цены;
		ВсегоНулевыхЦен = ВсегоНулевыхЦен + РезультатПакета.НулевыеЦены;
		ВсегоШтрихкодов = ВсегоШтрихкодов + РезультатПакета.Штрихкоды;
	КонецЕсли;

	Если ТоваровСоШтрихкодами > 0 И ВсегоШтрихкодов = 0 Тогда
		ВызватьИсключение
			"Star Club: 1С знайшла штрих-коди для "
			+ Строка(ТоваровСоШтрихкодами)
			+ " товарів, але backend повернув barcodes_synced=0. "
			+ "Перевірте, що на Railway розгорнута актуальна версія /api/1c/products/sync.";
	КонецЕсли;

	Сообщить(
		"Star Club: магазин '" + НазваниеМагазина + "' синхронізовано. "
		+ "Товарів: " + Строка(ВсегоТоваров)
		+ ", цін: " + Строка(ВсегоЦен)
		+ ", штрих-кодів збережено backend: " + Строка(ВсегоШтрихкодов)
		+ ", товарів зі штрих-кодами: " + Строка(ТоваровСоШтрихкодами)
		+ ", нульових цін: " + Строка(ВсегоНулевыхЦен)
	);

	Если СинхронізуватиФото Тогда
		СинхронізуватиФотоНоменклатуриStarClub();
	КонецЕсли;
КонецПроцедуры

Процедура СинхронізуватиВсіМагазиниStarClub(
	РазмерПакета = 200
) Экспорт
	Если РазмерПакета < 1 Тогда
		РазмерПакета = 200;
	КонецЕсли;

	УспешныхМагазинов = 0;
	КоличествоОшибок = 0;
	НайденоМагазинов = 0;

	ВыборкаМагазинов = Справочники.Магазины.Выбрать();
	Пока ВыборкаМагазинов.Следующий() Цикл
		Если ВыборкаМагазинов.ЭтоГруппа Или ВыборкаМагазинов.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Если StarClubКодМагазину(ВыборкаМагазинов.Ссылка) = "" Тогда
			Продолжить;
		КонецЕсли;

		НайденоМагазинов = НайденоМагазинов + 1;
		Попытка
			СинхронізуватиНоменклатуруStarClub(
				ВыборкаМагазинов.Ссылка,
				РазмерПакета,
				Ложь
			);
			УспешныхМагазинов = УспешныхМагазинов + 1;
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			Сообщить(
				"Star Club: магазин '" + StarClubНазваМагазину(ВыборкаМагазинов.Ссылка)
				+ "' не синхронізовано: " + ОписаниеОшибки()
			);
		КонецПопытки;
	КонецЦикла;

	Если НайденоМагазинов = 0 Тогда
		ВызватьИсключение "Star Club: у довіднику Магазины немає активних елементів із заповненим кодом";
	КонецЕсли;

	Сообщить(
		"Star Club: синхронізацію всіх магазинів завершено. Успішно: "
		+ Строка(УспешныхМагазинов) + ", помилок: " + Строка(КоличествоОшибок)
	);

	Если УспешныхМагазинов = 0 Тогда
		ВызватьИсключение "Star Club: не синхронізовано жодного магазину. Перевірте повідомлення вище";
	КонецЕсли;

	СинхронізуватиФотоНоменклатуриStarClub();
КонецПроцедуры


Функция StarClubАбсолютнеЧисло(
	Значение
) Экспорт

	Результат = 0;

	Попытка
		Результат = Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

	Если Результат < 0 Тогда
		Результат = -Результат;
	КонецЕсли;

	Возврат Результат;

КонецФункции
Функция StarClubОтриматиБазовуЦінуСтроки(
	СтрокаТовара
) Экспорт


	БазоваяЦена = 0;


	Попытка

		БазоваяЦена =
			Число(
				СтрокаТовара.StarClubБазоваяЦена
			);

	Исключение

		БазоваяЦена = 0;

	КонецПопытки;


	Если БазоваяЦена <= 0 Тогда


		Попытка

			БазоваяЦена =
				Число(
					СтрокаТовара.Цена
				);

		Исключение

			БазоваяЦена = 0;

		КонецПопытки;


		Если БазоваяЦена > 0 Тогда


			Попытка

				СтрокаТовара.StarClubБазоваяЦена =
					БазоваяЦена;

			Исключение
			КонецПопытки;


		КонецЕсли;


	КонецЕсли;


	Возврат БазоваяЦена;

КонецФункции
Функция ЦеКарткаStarClub(
	Карта
) Экспорт


	Если НЕ ЗначениеЗаполнено(
		Карта
	) Тогда

		Возврат Ложь;

	КонецЕсли;


	ГруппаStarClub =
		StarClubЗнайтиГрупуБонуснихКарток(
			Ложь
		);


	Если ГруппаStarClub <> Неопределено Тогда


		Попытка

			ТекущаяГруппа =
				Карта.Родитель;


			Пока ЗначениеЗаполнено(
				ТекущаяГруппа
			) Цикл


				Если
					ТекущаяГруппа
					= ГруппаStarClub
				Тогда

					Возврат Истина;

				КонецЕсли;


				ТекущаяГруппа =
					ТекущаяГруппа.Родитель;


			КонецЦикла;


		Исключение
		КонецПопытки;


	КонецЕсли;


	Возврат Ложь;

КонецФункции
Функция StarClubОтриматиБазовуЦінуРядка(
	СтрокаТовара,
	Магазин,
	ДатаЧека
) Экспорт

	Цена = 0;


	Если ДатаЧека = Неопределено Тогда
		ДатаЧека = ТекущаяДата();
	КонецЕсли;


	Характеристика =
		Справочники.
			ХарактеристикиНоменклатуры.
			ПустаяСсылка();


	Попытка

		Если ЗначениеЗаполнено(
			СтрокаТовара.ХарактеристикаНоменклатуры
		) Тогда

			Характеристика =
				СтрокаТовара.
					ХарактеристикаНоменклатуры;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Единица = Неопределено;


	Попытка

		Единица =
			СтрокаТовара.
				ЕдиницаИзмерения;

	Исключение
	КонецПопытки;


	Если НЕ ЗначениеЗаполнено(
		Единица
	) Тогда

		Попытка

			Единица =
				СтрокаТовара.
					Номенклатура.
					ЕдиницаХраненияОстатков;

		Исключение
		КонецПопытки;

	КонецЕсли;


	Попытка

		Цена =
			Ценообразование.
				ПолучитьЦенуНоменклатурыВРознице(
					ДатаЧека,
					Магазин,
					СтрокаТовара.Номенклатура,
					Характеристика,
					Единица
				);

	Исключение

		Цена = 0;

	КонецПопытки;


	// Якщо ціна з регістру недоступна, а рядок уже має знижку Star Club,
	// беремо збережену базову ціну, а не вже знижену.
	Если Цена <= 0 Тогда
		Попытка
			Если СтрокаТовара.StarClubПрименено
				И Число(СтрокаТовара.StarClubБазоваяЦена) > 0 Тогда
				Цена = Число(СтрокаТовара.StarClubБазоваяЦена);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Якщо штатна функція не знайшла ціну,
	// використовуємо поточну ціну рядка.
	Если Цена <= 0 Тогда

		Попытка

			Цена =
				Число(
					СтрокаТовара.Цена
				);

		Исключение

			Цена = 0;

		КонецПопытки;

	КонецЕсли;


	Если Цена < 0 Тогда
		Цена = -Цена;
	КонецЕсли;


	Возврат Цена;

КонецФункции
Функция РозрахуватиКлубніУмовиStarClub(
	ТоварыЧека,
	ДисконтнаяКарта,
	Магазин,
	ДатаЧека = Неопределено
) Экспорт

	Попытка


		Если НЕ ЗначениеЗаполнено(
			ДисконтнаяКарта
		) Тогда

			Возврат Неопределено;

		КонецЕсли;


		Если ДатаЧека = Неопределено Тогда
			ДатаЧека = ТекущаяДата();
		КонецЕсли;


		Данные =
			Новый Структура;


		КодКарты =
			СокрЛП(
				Строка(
					ДисконтнаяКарта.КодКарты
				)
			);


		Если НЕ ЗначениеЗаполнено(
			КодКарты
		) Тогда

			Возврат Неопределено;

		КонецЕсли;


		Данные.Вставить(
			"card_number",
			КодКарты
		);

		Данные.Вставить(
			"card_token",
			ОчиститиКодКартиStarClub(
				КодКарты
			)
		);

		StarClubДодатиМагазинВДані(
			Данные,
			Магазин
		);

		Данные.Вставить(
			"purchased_at",
			Формат(
				ДатаЧека,
				"ДФ=yyyy-MM-ddTHH:mm:ss"
			)
		);


		МассивТоваров =
			Новый Массив;

		НомерСтроки = 0;


		Для Каждого СтрокаТовара
			Из ТоварыЧека Цикл


			// Номер повинен збігатися з фізичною позицією в табличній частині.
			НомерСтроки =
				НомерСтроки + 1;


			Если НЕ ЗначениеЗаполнено(
				СтрокаТовара.Номенклатура
			) Тогда

				Продолжить;

			КонецЕсли;


			Количество =
				Число(
					СтрокаТовара.Количество
				);


			Если Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;


			БазоваяЦена =
				StarClubОтриматиБазовуЦінуРядка(
					СтрокаТовара,
					Магазин,
					ДатаЧека
				);


			ЦенаКоп =
				Окр(
					БазоваяЦена * 100,
					0
				);


			СуммаКоп =
				Окр(
					БазоваяЦена
					* Количество
					* 100,
					0
				);


			ТоварJSON =
				Новый Структура;


			ТоварJSON.Вставить(
				"line_no",
				НомерСтроки
			);


			StarClubДодатиКодиТоваруІГрупи(
				ТоварJSON,
				СтрокаТовара.Номенклатура
			);


			ТоварJSON.Вставить(
				"name",
				Строка(
					СтрокаТовара.
						Номенклатура.
						Наименование
				)
			);

			ТоварJSON.Вставить(
				"qty",
				Количество
			);

			ТоварJSON.Вставить(
				"regular_price_cents",
				ЦенаКоп
			);

			ТоварJSON.Вставить(
				"price_cents",
				ЦенаКоп
			);

			ТоварJSON.Вставить(
				"regular_line_total_cents",
				СуммаКоп
			);

			ТоварJSON.Вставить(
				"line_total_cents",
				СуммаКоп
			);


			Флаги =
				Новый Структура;

			Флаги.Вставить(
				"is_alcohol",
				Ложь
			);

			Флаги.Вставить(
				"is_tobacco",
				Ложь
			);

			Флаги.Вставить(
				"is_min_margin",
				Ложь
			);

			Флаги.Вставить(
				"no_star_accrual",
				Ложь
			);

			Флаги.Вставить(
				"no_redeem",
				Ложь
			);


			Попытка

				Если СтрокаТовара.
					Номенклатура.
					ПодакцизныйТовар
				Тогда

					Флаги.is_alcohol =
						Истина;

					Флаги.no_star_accrual =
						Истина;

					Флаги.no_redeem =
						Истина;

				КонецЕсли;

			Исключение
			КонецПопытки;


			ТоварJSON.Вставить(
				"flags",
				Флаги
			);


			МассивТоваров.Добавить(
				ТоварJSON
			);


		КонецЦикла;


		Если МассивТоваров.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;


		Данные.Вставить(
			"items",
			МассивТоваров
		);

        Данные.Вставить(
	"debug",
	Истина
); 
		HTTPОтвет =
			StarClubPOST(
				"/api/1c/calculate",
				Данные
			);


		ОтветСтрока =
			HTTPОтвет.
				ПолучитьТелоКакСтроку();


		Если HTTPОтвет.КодСостояния < 200
			Или HTTPОтвет.КодСостояния >= 300
		Тогда

			Возврат Неопределено;

		КонецЕсли;


		Возврат
			StarClubПрочитатьJSON(
				ОтветСтрока
			);


	Исключение

		Возврат Неопределено;

	КонецПопытки;

КонецФункции
// STAR CLUB: допоміжна перевірка числових полів відповіді /api/1c/calculate.
// Додано окремо, без заміни загальних JSON-функцій модуля.
Функция StarClubЧислоРасчета(ДанныеОтвета, ИмяПоля, ЗначениеПоУмолчанию = 0) Экспорт
    ЗначениеПоля = StarClubОтриматиПоле(ДанныеОтвета, ИмяПоля, Неопределено);
    Если ЗначениеПоля = Неопределено Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;
    Если ТипЗнч(ЗначениеПоля) = Тип("Null") Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;
    Попытка
        Возврат Число(ЗначениеПоля);
    Исключение
        Возврат ЗначениеПоУмолчанию;
    КонецПопытки;
КонецФункции

// Кінцева ціна вже враховує знижку Star Club. Штатна 1С-знижка
// не повинна застосовуватися до цієї ціни повторно.
Процедура StarClubОчиститьСкидкиДляКлубнойЦены(СтрокаТовара) Экспорт
    Попытка
        СтрокаТовара.ПроцентСкидкиНаценки = 0;
    Исключение
    КонецПопытки;
    Попытка
        СтрокаТовара.ПроцентСкидки = 0;
    Исключение
    КонецПопытки;
    Попытка
        СтрокаТовара.Скидка = 0;
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция ЗастосуватиКлубніУмовиStarClub(
    ТоварыЧека,
    ДисконтнаяКарта,
    Магазин,
    ДатаЧека = Неопределено,
    ПоказуватиПовідомлення = Ложь
) Экспорт

    Ответ = РозрахуватиКлубніУмовиStarClub(
        ТоварыЧека, ДисконтнаяКарта, Магазин, ДатаЧека);
    Если Ответ = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если НЕ Ответ.Свойство("items") Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Перевіряємо всі результати ДО зміни табличної частини.
    // Інакше вставка нового рядка порушить line_no наступних товарів.
    План = Новый Массив;
    Для Каждого РезультатТовара Из Ответ.items Цикл
        НомерСтроки = StarClubЧислоРасчета(РезультатТовара, "line_no", 0);
        Если НомерСтроки < 1 Или НомерСтроки > ТоварыЧека.Количество() Тогда
            Сообщить("Star Club: помилка line_no в розрахунку клубної ціни.");
            Возврат Неопределено;
        КонецЕсли;

        СтрокаТовара = ТоварыЧека.Получить(НомерСтроки - 1);
        Количество = Число(СтрокаТовара.Количество);
        Если Количество <= 0 Тогда
            Продолжить;
        КонецЕсли;

        // Для безпечного повернення звичайної ціни після зняття картки
        // потрібні два реквізити ТЧ Товары. Їх існування звіримо
        // окремо з метаданими документа, коли отримаємо його модуль.
        Попытка
            СуществующаяПометка = СтрокаТовара.StarClubПрименено;
            СуществующаяЦена = СтрокаТовара.StarClubБазоваяЦена;
        Исключение
            Сообщить("Star Club: немає StarClubПрименено або StarClubБазоваяЦена у ТЧ Товары. "
                + "Не змінюємо чек до перевірки метаданих документа.");
            Возврат Неопределено;
        КонецПопытки;

        КодОтвета = СокрЛП(Строка(StarClubОтриматиПоле(
            РезультатТовара, "external_product_id", "")));
        Если КодОтвета <> "" Тогда
            Если StarClubНормалізуватиКод1С(КодОтвета)
                <> StarClubНормалізуватиКод1С(СтрокаТовара.Номенклатура.Код) Тогда
                Сообщить("Star Club: backend повернув інший товар для рядка "
                    + Строка(НомерСтроки) + ". Чек не змінено.");
                Возврат Неопределено;
            КонецЕсли;
        КонецЕсли;

        ОбычнаяЦена = StarClubЧислоРасчета(РезультатТовара,
            "regular_unit_price_cents",
            StarClubЧислоРасчета(РезультатТовара, "regular_price_cents")) / 100;
        КлубнаяЦена = StarClubЧислоРасчета(РезультатТовара, "final_price_cents") / 100;
        ИтоговаяСумма = StarClubЧислоРасчета(РезультатТовара, "final_line_total_cents") / 100;
        Если ОбычнаяЦена < 0 Или КлубнаяЦена < 0 Или ИтоговаяСумма < 0 Тогда
            Сообщить("Star Club: backend повернув від'ємну ціну. Чек не змінено.");
            Возврат Неопределено;
        КонецЕсли;

        КлубноеПоле = StarClubОтриматиПоле(
            РезультатТовара, "club_priced_qty", Неопределено);
        ОбычноеПоле = StarClubОтриматиПоле(
            РезультатТовара, "regular_priced_qty", Неопределено);

        // Для оптових та інших правил backend повертає null для обох
        // частин — тоді залишається один рядок зі звичайною схемою.
        Разделить = Ложь;
        ЕстьЛимитныеКоличество = ТипЗнч(КлубноеПоле) = Тип("Число")
            И ТипЗнч(ОбычноеПоле) = Тип("Число");
        КоличествоКлубное = 0;
        КоличествоОбычное = 0;
        Если ЕстьЛимитныеКоличество Тогда
            КоличествоКлубное = Число(КлубноеПоле);
            КоличествоОбычное = Число(ОбычноеПоле);
            Разница = Окр(КоличествоКлубное + КоличествоОбычное - Количество, 6);
            Если КоличествоКлубное < 0 Или КоличествоОбычное < 0 Или Разница <> 0 Тогда
                Сообщить("Star Club: невідповідність кількості клубних і звичайних одиниць.");
                Возврат Неопределено;
            КонецЕсли;
            // Ціна з відповіді для рядка з клубним лімітом може бути
            // клубною, навіть якщо всі одиниці вже перевищили ліміт.
            Разделить = КоличествоКлубное > 0 И КоличествоОбычное > 0;
            КонтрольСуммы = Окр(КлубнаяЦена * КоличествоКлубное
                + ОбычнаяЦена * КоличествоОбычное, 2);
            Если КонтрольСуммы - ИтоговаяСумма > 0.01
                Или ИтоговаяСумма - КонтрольСуммы > 0.01 Тогда
                Сообщить("Star Club: сума рядка не відповідає кількості й цінам.");
                Возврат Неопределено;
            КонецЕсли;
        КонецЕсли;

        РядокПлану = Новый Структура;
        РядокПлану.Вставить("Строка", СтрокаТовара);
        РядокПлану.Вставить("Разделить", Разделить);
        РядокПлану.Вставить("ЕстьЛимитныеКоличество", ЕстьЛимитныеКоличество);
        РядокПлану.Вставить("КлубноеКоличество", КоличествоКлубное);
        РядокПлану.Вставить("ОбычноеКоличество", КоличествоОбычное);
        РядокПлану.Вставить("КлубнаяЦена", КлубнаяЦена);
        РядокПлану.Вставить("ОбычнаяЦена", ОбычнаяЦена);
        РядокПлану.Вставить("ИтоговаяСумма", ИтоговаяСумма);
        План.Добавить(РядокПлану);
    КонецЦикла;

    // Позиції з кількісним лімітом: N одиниць за клубною ціною,
    // решта — окремим рядком за звичайною ціною 1С.
    Для Каждого РядокПлану Из План Цикл
        ИсходнаяСтрока = РядокПлану.Строка;
        Если РядокПлану.Разделить Тогда
            НоваяСтрока = ТоварыЧека.Добавить();
            ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходнаяСтрока);

            НоваяСтрока.Количество = РядокПлану.ОбычноеКоличество;
            НоваяСтрока.Цена = РядокПлану.ОбычнаяЦена;
            НоваяСтрока.Сумма = Окр(НоваяСтрока.Цена * НоваяСтрока.Количество, 2);
            НоваяСтрока.StarClubБазоваяЦена = РядокПлану.ОбычнаяЦена;
            НоваяСтрока.StarClubПрименено = Истина;
            StarClubОчиститьСкидкиДляКлубнойЦены(НоваяСтрока);

            ИсходнаяСтрока.Количество = РядокПлану.КлубноеКоличество;
            ИсходнаяСтрока.Цена = РядокПлану.КлубнаяЦена;
            ИсходнаяСтрока.Сумма = Окр(ИсходнаяСтрока.Цена * ИсходнаяСтрока.Количество, 2);
            ИсходнаяСтрока.StarClubБазоваяЦена = РядокПлану.ОбычнаяЦена;
            ИсходнаяСтрока.StarClubПрименено = Истина;
            StarClubОчиститьСкидкиДляКлубнойЦены(ИсходнаяСтрока);

            // Звичайний рядок одразу після клубного.
            Попытка
                ИсходныйИндекс = ТоварыЧека.Индекс(ИсходнаяСтрока);
                НовыйИндекс = ТоварыЧека.Индекс(НоваяСтрока);
                Если НовыйИндекс > ИсходныйИндекс + 1 Тогда
                    ТоварыЧека.Сдвинуть(НоваяСтрока, ИсходныйИндекс + 1 - НовыйИндекс);
                КонецЕсли;
            Исключение
                // На нестандартній колекції РМК рядок залишиться в кінці.
            КонецПопытки;
        Иначе
            Если РядокПлану.ЕстьЛимитныеКоличество
                И РядокПлану.КлубноеКоличество = 0 Тогда
                // Ліміт уже вичерпано попередніми рядками цього товару.
                НоваяЦена = РядокПлану.ОбычнаяЦена;
            Иначе
                НоваяЦена = РядокПлану.КлубнаяЦена;
            КонецЕсли;
            ИсходнаяСтрока.Цена = НоваяЦена;
            ИсходнаяСтрока.Сумма = РядокПлану.ИтоговаяСумма;
            ИсходнаяСтрока.StarClubБазоваяЦена = РядокПлану.ОбычнаяЦена;
            ИсходнаяСтрока.StarClubПрименено = Истина;
            StarClubОчиститьСкидкиДляКлубнойЦены(ИсходнаяСтрока);
        КонецЕсли;
    КонецЦикла;

    Если ПоказуватиПовідомлення Тогда
        Сообщить("Star Club: клубні ціни застосовано з урахуванням ліміту кількості.");
    КонецЕсли;
    Возврат Ответ;
КонецФункции
Функция ЗастосуватиЦіниДоДокументаStarClub(
	ДокументЧек
) Экспорт


	Если ДокументЧек = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;


	Если НЕ ЗначениеЗаполнено(ДокументЧек.ДисконтнаяКарта) Тогда
		СкинутиЦіниStarClub(ДокументЧек.Товары);
		ДокументЧек.СуммаДокумента = ДокументЧек.Товары.Итог("Сумма");
		Возврат Истина;
	КонецЕсли;

	Если НЕ ЦеКарткаStarClub(ДокументЧек.ДисконтнаяКарта) Тогда
		СкинутиЦіниStarClub(ДокументЧек.Товары);
		ДокументЧек.СуммаДокумента = ДокументЧек.Товары.Итог("Сумма");
		Возврат Истина;
	КонецЕсли;


	МагазинЧека =
		ДокументЧек.Магазин;


	Если НЕ ЗначениеЗаполнено(
		МагазинЧека
	) Тогда

		Попытка

			МагазинЧека =
				ДокументЧек.
					КассаККМ.
					Магазин;

		Исключение
		КонецПопытки;

	КонецЕсли;


	Ответ =
		ЗастосуватиКлубніУмовиStarClub(
			ДокументЧек.Товары,
			ДокументЧек.ДисконтнаяКарта,
			МагазинЧека,
			ДокументЧек.Дата,
			Ложь
		);


	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;


	ДокументЧек.СуммаДокумента =
		ДокументЧек.
			Товары.
			Итог(
				"Сумма"
			);


	Возврат Истина;

КонецФункции
Процедура СкинутиЦіниStarClub(
	ТоварыЧека
) Экспорт


	Для Каждого СтрокаТовара
		Из ТоварыЧека Цикл


		Применено = Ложь;


		Попытка

			Применено =
				СтрокаТовара.StarClubПрименено;

		Исключение
		КонецПопытки;


		Если НЕ Применено Тогда

			Продолжить;

		КонецЕсли;


		БазоваяЦена = 0;


		Попытка

			БазоваяЦена =
				Число(
					СтрокаТовара.StarClubБазоваяЦена
				);

		Исключение
		КонецПопытки;


		Если БазоваяЦена <= 0 Тогда

			Продолжить;

		КонецЕсли;


		СтрокаТовара.Цена =
			БазоваяЦена;


		СтрокаТовара.Сумма =
			Окр(

				БазоваяЦена
				* СтрокаТовара.Количество,

				2

			);


		Попытка

			СтрокаТовара.Скидка = 0;

		Исключение
		КонецПопытки;


		Попытка

			СтрокаТовара.ПроцентСкидки = 0;

		Исключение
		КонецПопытки;


		Попытка

			СтрокаТовара.StarClubПрименено =
				Ложь;

		Исключение
		КонецПопытки;


	КонецЦикла;

КонецПроцедуры

Функция ПерерахуватиЦіниЧекаStarClub(
	ДокументЧек
) Экспорт


	Если ДокументЧек = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;


	ЕстьКарта = Ложь;


	Попытка

		ЕстьКарта =
			ЗначениеЗаполнено(
				ДокументЧек.ДисконтнаяКарта
			);

	Исключение
	КонецПопытки;


	Если НЕ ЕстьКарта Тогда


		СкинутиЦіниStarClub(
			ДокументЧек.Товары
		);

		ДокументЧек.СуммаДокумента = ДокументЧек.Товары.Итог("Сумма");


		Возврат Истина;


	КонецЕсли;


	Если НЕ ЦеКарткаStarClub(
		ДокументЧек.ДисконтнаяКарта
	) Тогда


		СкинутиЦіниStarClub(
			ДокументЧек.Товары
		);

		ДокументЧек.СуммаДокумента = ДокументЧек.Товары.Итог("Сумма");


		Возврат Истина;


	КонецЕсли;


	Ответ =
		ЗастосуватиКлубніУмовиStarClub(

			ДокументЧек.Товары,

			ДокументЧек.ДисконтнаяКарта,

			ДокументЧек.Магазин,

			ДокументЧек.Дата,

			Ложь

		);


	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ДокументЧек.СуммаДокумента = ДокументЧек.Товары.Итог("Сумма");
	Возврат Истина;

КонецФункции
Функция StarClubКодЗаЗіркиЗКоментаря(КомментарийЧека) Экспорт
	КомментарийСтрокой = Строка(КомментарийЧека);
	Маркер = "STARCLUB_CODE=";
	Позиция = СтрНайти(КомментарийСтрокой, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Код = Сред(КомментарийСтрокой, Позиция + СтрДлина(Маркер));
	ПозицияПереноса = СтрНайти(Код, Символы.ПС);
	Если ПозицияПереноса > 0 Тогда
		Код = Лев(Код, ПозицияПереноса - 1);
	КонецЕсли;

	Возврат СокрЛП(Код);
	
КонецФункции
// ============================================================
// Отримання одноразового коду персональної знижки
// з коментаря чека
// ============================================================
Функция StarClubПерсональнийКодЗКоментаря(
	КомментарийЧека
) Экспорт

	КомментарийСтрокой =
		Строка(
			КомментарийЧека
		);


	Маркер =
		"STARCLUB_COUPON=";


	Позиция =
		СтрНайти(
			КомментарийСтрокой,
			Маркер
		);


	Если Позиция = 0 Тогда

		Возврат "";

	КонецЕсли;


	Код =
		Сред(
			КомментарийСтрокой,
			Позиция
				+
				СтрДлина(
					Маркер
				)
		);


	// Відрізаємо службове поле:
	// STARCLUB_COUPON=SALE-XXX;MAX_UNITS=3
	ПозицияТочкиСКомой =
		СтрНайти(
			Код,
			";"
		);


	Если ПозицияТочкиСКомой > 0 Тогда

		Код =
			Лев(
				Код,
				ПозицияТочкиСКомой - 1
			);

	КонецЕсли;


	// Страховка для багаторядкового коментаря.
	ПозицияПереноса =
		СтрНайти(
			Код,
			Символы.ПС
		);


	Если ПозицияПереноса > 0 Тогда

		Код =
			Лев(
				Код,
				ПозицияПереноса - 1
			);

	КонецЕсли;


	Возврат
		СокрЛП(
			Код
		);

КонецФункции
Функция ПеревіритиКодТовараЗаЗіркиСтруктура(КодQR) Экспорт
	Попытка
		Данные = Новый Структура;
		Данные.Вставить("token", СокрЛП(Строка(КодQR)));

		HTTPОтвет = StarClubPOST("/api/1c/reward-qr/validate", Данные);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния < 200 Или HTTPОтвет.КодСостояния >= 300 Тогда
			Сообщить("Star Club: код недійсний. Код HTTP: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
			Возврат Неопределено;
		КонецЕсли;

		Возврат StarClubПрочитатьJSON(ОтветСтрока);
	Исключение
		Сообщить("Star Club: помилка перевірки коду: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ДодатиТоварЗаЗіркиВЧекStarClub(
	ДокументЧек,
	КодQR
) Экспорт

	// Перевіряємо код на сервері.
	Ответ =
		ПеревіритиКодТовараЗаЗіркиСтруктура(
			КодQR
		);

	Если Ответ = Неопределено Тогда

		Возврат Ложь;

	КонецЕсли;


	QR =
		StarClubОтриматиПоле(
			Ответ,
			"qr",
			Неопределено
		);

	Если QR = Неопределено Тогда

		Сообщить(
			"Star Club: сервер не повернув дані коду."
		);

		Возврат Ложь;

	КонецЕсли;


	// ============================================================
	// Визначаємо, який саме код отримано:
	// 1) звичайний товар за зірки;
	// 2) персональна одноразова знижка.
	// ============================================================

	// ============================================================
// Надійно визначаємо тип коду.
// Backend може повернути тип як усередині qr,
// так і у верхньому об’єкті відповіді.
// ============================================================

ТипКодаStarClub =
	"";


// Спочатку шукаємо code_type у qr.
Попытка

	ТипКодаStarClub =
		СокрЛП(
			Строка(
				StarClubОтриматиПоле(
					QR,
					"code_type",
					""
				)
			)
		);

Исключение
	ТипКодаStarClub = "";
КонецПопытки;


// Якщо code_type у qr немає — перевіряємо корінь відповіді.
Если ТипКодаStarClub = "" Тогда

	ТипКодаStarClub =
		СокрЛП(
			Строка(
				StarClubОтриматиПоле(
					Ответ,
					"code_type",
					""
				)
			)
		);

КонецЕсли;


// Додаткові можливі назви поля.
Если ТипКодаStarClub = "" Тогда

	ТипКодаStarClub =
		СокрЛП(
			Строка(
				StarClubОтриматиПоле(
					QR,
					"source_type",
					StarClubОтриматиПоле(
						Ответ,
						"source_type",
						""
					)
				)
			)
		);

КонецЕсли;


Если ТипКодаStarClub = "" Тогда

	ТипКодаStarClub =
		СокрЛП(
			Строка(
				StarClubОтриматиПоле(
					QR,
					"type",
					StarClubОтриматиПоле(
						Ответ,
						"type",
						""
					)
				)
			)
		);

КонецЕсли;


// Нормалізуємо регістр.
ТипКодаStarClub =
	НРег(
		СокрЛП(
			ТипКодаStarClub
		)
	);


// Додаткові ознаки персональної знижки.
ПроцентПерсональнойСкидки =
	0;

Попытка

	ПроцентПерсональнойСкидки =
		Число(
			StarClubОтриматиПоле(
				QR,
				"discount_percent",
				0
			)
		);

Исключение
	ПроцентПерсональнойСкидки = 0;
КонецПопытки;


КодQRСтрокой =
	ВРег(
		СокрЛП(
			Строка(
				КодQR
			)
		)
	);


// Персональною знижкою вважаємо код, якщо:
// 1. backend повернув відповідний тип;
// 2. є відсоток персональної знижки;
// 3. код починається із SALE-.
ЭтоПерсональнаяСкидка =
	ТипКодаStarClub = "personal_coupon"
	Или ТипКодаStarClub = "personal_discount"
	Или ТипКодаStarClub = "discount_coupon"
	Или ТипКодаStarClub = "coupon"
	Или ТипКодаStarClub = "discount"
	Или ПроцентПерсональнойСкидки > 0
	Или Лев(
		КодQRСтрокой,
		5
	) = "SALE-";


	КодТовара1С =
		СокрЛП(
			Строка(
				StarClubОтриматиПоле(
					QR,
					"product_external_id",
					""
				)
			)
		);


	НазваниеТовара =
		Строка(
			StarClubОтриматиПоле(
				QR,
				"product_name",
				?(ЭтоПерсональнаяСкидка,
					"Товар за персональною знижкою",
					"Товар за зірки"
				)
			)
		);


	ЦенаЗірок =
		Число(
			StarClubОтриматиПоле(
				QR,
				"stars_to_spend",
				0
			)
		);


	// ============================================================
	// Визначаємо кількість і ціну рядка
	// ============================================================

	Если ЭтоПерсональнаяСкидка Тогда

	// Товар при введенні коду додаємо однією одиницею.
	// Максимальний ліміт зберігаємо окремо.
	Количество =
		1;


	МаксимумЕдиницПерсональнойСкидки =
		1;


	Попытка

		МаксимумЕдиницПерсональнойСкидки =
			Число(
				StarClubОтриматиПоле(
					QR,
					"max_units",
					StarClubОтриматиПоле(
						QR,
						"max_discount_units",
						1
					)
				)
			);

	Исключение

		МаксимумЕдиницПерсональнойСкидки =
			1;

	КонецПопытки;


	МаксимумЕдиницПерсональнойСкидки =
		Цел(
			МаксимумЕдиницПерсональнойСкидки
		);


	Если МаксимумЕдиницПерсональнойСкидки < 1 Тогда

		МаксимумЕдиницПерсональнойСкидки =
			1;

	КонецЕсли;


	// Далі залишаєш свій наявний розрахунок:
	// final_price_cents, discounted_price_cents,
	// price_cents, original_price_cents тощо.

// 1. Насамперед пробуємо отримати остаточну ціну.
ЦенаДляЧекаКоп =
	0;

Попытка

	ЦенаДляЧекаКоп =
		Число(
			StarClubОтриматиПоле(
				QR,
				"final_price_cents",
				0
			)
		);

Исключение
	ЦенаДляЧекаКоп = 0;
КонецПопытки;


// 2. Друга можлива назва поля.
Если ЦенаДляЧекаКоп <= 0 Тогда

	Попытка

		ЦенаДляЧекаКоп =
			Число(
				StarClubОтриматиПоле(
					QR,
					"discounted_price_cents",
					0
				)
			);

	Исключение
		ЦенаДляЧекаКоп = 0;
	КонецПопытки;

КонецЕсли;


// 3. Стандартне поле price_cents.
Если ЦенаДляЧекаКоп <= 0 Тогда

	Попытка

		ЦенаДляЧекаКоп =
			Число(
				StarClubОтриматиПоле(
					QR,
					"price_cents",
					0
				)
			);

	Исключение
		ЦенаДляЧекаКоп = 0;
	КонецПопытки;

КонецЕсли;


// 4. Якщо backend повернув ціну у гривнях.
Если ЦенаДляЧекаКоп <= 0 Тогда

	Попытка

		ЦенаДляЧекаГрн =
			Число(
				StarClubОтриматиПоле(
					QR,
					"price_uah",
					0
				)
			);

		Если ЦенаДляЧекаГрн > 0 Тогда

			ЦенаДляЧекаКоп =
				Окр(
					ЦенаДляЧекаГрн * 100,
					0
				);

		КонецЕсли;

	Исключение
	КонецПопытки;

КонецЕсли;


// 5. Резервний розрахунок:
// звичайна ціна мінус відсоток знижки.
Если ЦенаДляЧекаКоп <= 0 Тогда

	ИсходнаяЦенаКоп =
		0;

	ПроцентСкидки =
		0;


	Попытка

		ИсходнаяЦенаКоп =
			Число(
				StarClubОтриматиПоле(
					QR,
					"original_price_cents",
					StarClubОтриматиПоле(
						QR,
						"regular_price_cents",
						0
					)
				)
			);

	Исключение
		ИсходнаяЦенаКоп = 0;
	КонецПопытки;


	Попытка

		ПроцентСкидки =
			Число(
				StarClubОтриматиПоле(
					QR,
					"discount_percent",
					0
				)
			);

	Исключение
		ПроцентСкидки = 0;
	КонецПопытки;


	Если ИсходнаяЦенаКоп > 0
		И ПроцентСкидки > 0 Тогда

		ЦенаДляЧекаКоп =
			Окр(
				ИсходнаяЦенаКоп
				*
				(
					100 - ПроцентСкидки
				)
				/
				100,
				0
			);

	КонецЕсли;

КонецЕсли;


// Не дозволяємо персональній знижці
// випадково перейти на технічну ціну 10 копійок.
Если ЦенаДляЧекаКоп <= 0 Тогда

	Сообщить(
		"Star Club: сервер визначив персональну знижку, "
		+ "але не повернув остаточну ціну товару."
		+ Символы.ПС
		+ "Тип коду: "
		+ ТипКодаStarClub
		+ Символы.ПС
		+ "Код: "
		+ Строка(
			КодQR
		)
	);

	Возврат Ложь;

КонецЕсли;


ЦенаДляЧека =
	ЦенаДляЧекаКоп / 100;

ЦенаЗірок =
	0;

	Иначе

		Количество =
			Число(
				StarClubОтриматиПоле(
					QR,
					"qty",
					1
				)
			);

		Если Количество <= 0 Тогда

			Количество =
				1;

		КонецЕсли;


		ТехнічнаЦінаКоп =
			Число(
				StarClubОтриматиПоле(
					QR,
					"technical_price_cents",
					10
				)
			);

		Если ТехнічнаЦінаКоп < 1 Тогда

			ТехнічнаЦінаКоп =
				10;

		КонецЕсли;


		ЦенаДляЧека =
			ТехнічнаЦінаКоп / 100;

	КонецЕсли;


	// ============================================================
	// Перевіряємо код товару 1С
	// ============================================================

	Если НЕ ЗначениеЗаполнено(
		КодТовара1С
	) Тогда

		Если ЭтоПерсональнаяСкидка Тогда

			Сообщить(
				"Star Club: у персональній знижці "
				+ "не вказано код товару 1С."
			);

		Иначе

			Сообщить(
				"Star Club: для товару за зірки "
				+ "не вказано код товару 1С."
			);

		КонецЕсли;

		Возврат Ложь;

	КонецЕсли;


	Номенклатура =
		Справочники.
			Номенклатура.
			НайтиПоКоду(
				КодТовара1С
			);


	Если НЕ ЗначениеЗаполнено(
		Номенклатура
	)
		Или Номенклатура.Пустая() Тогда

		Сообщить(
			"Star Club: товар не знайдено в 1С."
			+ Символы.ПС
			+ "Код: "
			+ КодТовара1С
			+ Символы.ПС
			+ "Назва: "
			+ НазваниеТовара
		);

		Возврат Ложь;

	КонецЕсли;


	// ============================================================
	// Додаємо ОКРЕМИЙ рядок у чек
	// ============================================================

	НоваяСтрока =
		ДокументЧек.
			Товары.
			Добавить();

	НоваяСтрока.Номенклатура =
		Номенклатура;

	НоваяСтрока.Количество =
		Количество;

	НоваяСтрока.Цена =
		ЦенаДляЧека;

	НоваяСтрока.Сумма =
		Окр(
			ЦенаДляЧека * Количество,
			2
		);


	Попытка

		НоваяСтрока.Коэффициент =
			1;

	Исключение
	КонецПопытки;


	Попытка

		Если ЗначениеЗаполнено(
			Номенклатура.
				ЕдиницаХраненияОстатков
		) Тогда

			НоваяСтрока.ЕдиницаИзмерения =
				Номенклатура.
					ЕдиницаХраненияОстатков;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Попытка

		Если ЗначениеЗаполнено(
			ДокументЧек.
				КассаККМ.
					Склад
		) Тогда

			НоваяСтрока.Склад =
				ДокументЧек.
					КассаККМ.
						Склад;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Попытка

		Если НЕ ЗначениеЗаполнено(
			НоваяСтрока.Склад
		)
			И ЗначениеЗаполнено(
				ДокументЧек.
					Магазин.
						Склад
			) Тогда

			НоваяСтрока.Склад =
				ДокументЧек.
					Магазин.
						Склад;

		КонецЕсли;

	Исключение
	КонецПопытки;


	// ============================================================
	// Автоматично прив’язуємо картку клієнта
	// ============================================================

	Клиент =
		StarClubОтриматиПоле(
			QR,
			"client",
			Новый Структура
		);

	КодКарты =
		Строка(
			StarClubОтриматиПоле(
				Клиент,
				"card_number",
				""
			)
		);


	Если ЗначениеЗаполнено(
		КодКарты
	) Тогда

		Карта1С =
			StarClubЗнайтиКарткуВ1С(
				КодКарты
			);
        		Если НЕ ЗначениеЗаполнено(
			Карта1С
		) Тогда

			// Картки ще немає локально — знаходимо клієнта
			// на сервері та створюємо/оновлюємо картку в 1С.
			Попытка

				Карта1С =
					ШвидкийПошукКлієнтаStarClub(
						КодКарты
					);

			Исключение

				Карта1С =
					Неопределено;

			КонецПопытки;

		КонецЕсли;
		Если ЗначениеЗаполнено(
			Карта1С
		) Тогда

			Попытка

				ДокументЧек.ДисконтнаяКарта =
					Карта1С;

			Исключение
			КонецПопытки;

		КонецЕсли;

	КонецЕсли;


	// ============================================================
	// Запам’ятовуємо код у коментарі чека
	// ============================================================

	СтарыйКомментарий =
		Строка(
			ДокументЧек.Комментарий
		);


	Если ЭтоПерсональнаяСкидка Тогда

		МаркерКода =
			"STARCLUB_COUPON=";

	Иначе

		МаркерКода =
			"STARCLUB_CODE=";

	КонецЕсли;


	// Не дозволяємо використати другий код цього типу
	// у тому самому чеку.
	Если СтрНайти(
		СтарыйКомментарий,
		МаркерКода
	) > 0 Тогда

		// Видаляємо щойно доданий дубльований рядок.
		ДокументЧек.
			Товары.
				Удалить(
					НоваяСтрока
				);

		Если ЭтоПерсональнаяСкидка Тогда

			Сообщить(
				"Star Club: у цьому чеку вже застосована "
				+ "персональна знижка."
			);

		Иначе

			Сообщить(
				"Star Club: у цьому чеку вже використаний "
				+ "код товару за зірки."
			);

		КонецЕсли;

		Возврат Ложь;

	КонецЕсли;


	Если ЗначениеЗаполнено(
		СтарыйКомментарий
	) Тогда

		СтарыйКомментарий =
			СтарыйКомментарий
			+ Символы.ПС;

	КонецЕсли;


	Если ЭтоПерсональнаяСкидка Тогда

	ДокументЧек.Комментарий =
		СтарыйКомментарий
		+
		МаркерКода
		+
		СокрЛП(
			Строка(
				КодQR
			)
		)
		+
		";MAX_UNITS="
		+
		Строка(
			МаксимумЕдиницПерсональнойСкидки
		);

Иначе

	ДокументЧек.Комментарий =
		СтарыйКомментарий
		+
		МаркерКода
		+
		СокрЛП(
			Строка(
				КодQR
			)
		);

КонецЕсли;

	// ============================================================
	// Повідомлення касиру
	// ============================================================

	Если ЭтоПерсональнаяСкидка Тогда

		ИсходнаяЦенаКоп =
			Число(
				StarClubОтриматиПоле(
					QR,
					"original_price_cents",
					0
				)
			);

		ПроцентСкидки =
			Число(
				StarClubОтриматиПоле(
					QR,
					"discount_percent",
					0
				)
			);


		Сообщить(
			"Star Club: персональну знижку застосовано."
			+ Символы.ПС
			+ "Товар: "
			+ НазваниеТовара
			+ Символы.ПС
			+ "Звичайна ціна: "
			+ Формат(
				ИсходнаяЦенаКоп / 100,
				"ЧДЦ=2"
			)
			+ " грн"
			+ Символы.ПС
			+ "Знижка: "
			+ Формат(
				ПроцентСкидки,
				"ЧДЦ=0"
			)
			+ "%"
			+ Символы.ПС
			+ "Ціна зі знижкою: "
			+ Формат(
				ЦенаДляЧека,
				"ЧДЦ=2"
			)
			+ " грн"
			+ Символы.ПС
			+ "Максимальна кількість товару зі знижкою: "
+ Строка(
	МаксимумЕдиницПерсональнойСкидки
)
+ " шт."
		);

	Иначе

		Сообщить(
			"Star Club: товар за зірки додано в чек."
			+ Символы.ПС
			+ "Товар: "
			+ НазваниеТовара
			+ Символы.ПС
			+ "Технічна ціна: "
			+ Формат(
				ЦенаДляЧека,
				"ЧДЦ=2"
			)
			+ " грн"
			+ Символы.ПС
			+ "До списання: "
			+ Строка(
				ЦенаЗірок
			)
			+ " зірок"
		);

	КонецЕсли;


	Возврат Истина;

КонецФункции
// Повернення розпізнаємо і при прямому виклику відправлення чека з РМК.
Функция StarClubЦеПовернення(ДокументЧек) Экспорт
	Попытка
		Если ДокументЧек.ВидОперации = Перечисления.ВидыОперацийЧекККМ.Возврат Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Операция = НРег(Строка(ДокументЧек.ВидОперации));
		Если СтрНайти(Операция, "возврат") > 0 Или СтрНайти(Операция, "повернен") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		ИмяДокумента = НРег(ДокументЧек.Метаданные().Имя);
		Если СтрНайти(ИмяДокумента, "возврат") > 0 Или СтрНайти(ИмяДокумента, "повернен") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если ДокументЧек.СуммаДокумента < 0 Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Процедура ОтправитьЧекВStarClub(ДокументЧек, КодQRЗаЗірки = "") Экспорт
	Попытка
		Если StarClubЦеПовернення(ДокументЧек) Тогда
			ОтправитьВозвратВStarClub(ДокументЧек);
			Возврат;
		КонецЕсли;


		// ============================================================
		// Технічне поповнення StarClub не відправляємо
		// як звичайний чек на /api/1c/receipts.
		// Його окремо обробляють prepare і complete.
		// ============================================================

		ЭтоПополнениеStarClub = Ложь;

		Для Каждого СтрокаТовараПополнение
			Из ДокументЧек.Товары Цикл

			Попытка

				Если ВРег(
					СокрЛП(
						Строка(
							СтрокаТовараПополнение.
								Номенклатура.
									Артикул
						)
					)
				) = "STARCLUB_TOPUP" Тогда

					ЭтоПополнениеStarClub = Истина;
					Прервать;

				КонецЕсли;

			Исключение
				// Якщо артикул недоступний,
				// просто перевіряємо наступний рядок.
			КонецПопытки;

		КонецЦикла;


		Если ЭтоПополнениеStarClub Тогда

			Сообщить(
				"[STARCLUB TOPUP DEBUG] "
				+ "Технічний чек поповнення не відправляється "
				+ "на /api/1c/receipts. "
				+ "Очікується окремий complete."
			);

			Возврат;

		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(КодQRЗаЗірки) Тогда
			Попытка
				КодQRЗаЗірки = StarClubКодЗаЗіркиЗКоментаря(ДокументЧек.Комментарий);
			Исключение
				КодQRЗаЗірки = "";
			КонецПопытки;
		КонецЕсли;
				// Персональна одноразова знижка з коментаря чека.
		КодПерсональнойСкидки =
			"";

		Попытка

			КодПерсональнойСкидки =
				StarClubПерсональнийКодЗКоментаря(
					ДокументЧек.Комментарий
				);

		Исключение

			КодПерсональнойСкидки =
				"";

		КонецПопытки;

		ЕстьКарта = Ложь;
		Попытка
			ЕстьКарта = ЗначениеЗаполнено(ДокументЧек.ДисконтнаяКарта);
		Исключение
		КонецПопытки;

		// Звичайний чек без бонусної картки не блокуємо та не відправляємо в програму лояльності.
				Если НЕ ЕстьКарта
			И НЕ ЗначениеЗаполнено(
				КодQRЗаЗірки
			)
			И НЕ ЗначениеЗаполнено(
				КодПерсональнойСкидки
			) Тогда

			Возврат;

		КонецЕсли;
		ДанныеЧека = Новый Структура;
		ДанныеЧека.Вставить(
	"id",
	СокрЛП(
		Строка(
			ДокументЧек.Номер
		)
	)
);
		ДанныеЧека.Вставить("fiscal_number", Строка(ДокументЧек.Номер));
		ДанныеЧека.Вставить("purchased_at", Формат(ДокументЧек.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		StarClubДодатиМагазинВДані(ДанныеЧека, ДокументЧек.Магазин);
		ДанныеЧека.Вставить("cash_register", Строка(ДокументЧек.КассаККМ));
		ДанныеЧека.Вставить("cashier", Строка(ДокументЧек.Продавец));
		ОбщаяСуммаЧекаStarClub =
	0;

Попытка

	ОбщаяСуммаЧекаStarClub =
		ДокументЧек.
			Товары.
				Итог(
					"Сумма"
				);

Исключение

	ОбщаяСуммаЧекаStarClub =
		ДокументЧек.
			СуммаДокумента;

КонецПопытки;


ДанныеЧека.Вставить(
	"total_cents",
	Окр(
		ОбщаяСуммаЧекаStarClub
		*
		100,
		0
	)
);		ДанныеЧека.Вставить("stars_spent", 0);

		Если ЕстьКарта Тогда
			КодКарты = Строка(ДокументЧек.ДисконтнаяКарта.КодКарты);
			ДанныеЧека.Вставить("card_number", КодКарты);
			ДанныеЧека.Вставить("card_token", ОчиститиКодКартиStarClub(КодКарты));
		Иначе
			ДанныеЧека.Вставить("card_number", "");
			ДанныеЧека.Вставить("card_token", "");
		КонецЕсли;

				Если ЗначениеЗаполнено(
			КодПерсональнойСкидки
		) Тогда

			ДанныеЧека.Вставить(
				"personal_coupon_code",
				СокрЛП(
					Строка(
						КодПерсональнойСкидки
					)
				)
			);

		ИначеЕсли ЗначениеЗаполнено(
			КодQRЗаЗірки
		) Тогда

			ДанныеЧека.Вставить(
				"reward_qr_token",
				СокрЛП(
					Строка(
						КодQRЗаЗірки
					)
				)
			);

		КонецЕсли;

		ТоварыJSON = Новый Массив;
		РазрешеннаяСуммаКоп = 0;

		Для Каждого СтрокаТовара Из ДокументЧек.Товары Цикл
			ТоварJSON = Новый Структура;
			СуммаСтрокиКоп = Окр(СтрокаТовара.Сумма * 100, 0);
			ЦенаКоп = Окр(СтрокаТовара.Цена * 100, 0);

			StarClubДодатиКодиТоваруІГрупи(ТоварJSON, СтрокаТовара.Номенклатура);
			ТоварJSON.Вставить("name", Строка(СтрокаТовара.Номенклатура.Наименование));
			ТоварJSON.Вставить("qty", СтрокаТовара.Количество);
			ТоварJSON.Вставить("price_cents", ЦенаКоп);
			ТоварJSON.Вставить("line_total_cents", СуммаСтрокиКоп);

			Флаги = Новый Структура;
			Флаги.Вставить("is_alcohol", Ложь);
			Флаги.Вставить("is_tobacco", Ложь);
			Флаги.Вставить("is_min_margin", Ложь);
			Флаги.Вставить("no_star_accrual", Ложь);
			Флаги.Вставить("no_redeem", Ложь);

			Попытка
				Если СтрокаТовара.Номенклатура.ПодакцизныйТовар Тогда
					Флаги.is_alcohol = Истина;
					Флаги.no_star_accrual = Истина;
					Флаги.no_redeem = Истина;
				Иначе
					РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
				КонецЕсли;
			Исключение
				РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
			КонецПопытки;

									// Тільки рядок із технічною ціною 0,10 грн
			// є товаром за зірки.
						// ========================================================
			// Тільки товар за зірки по технічній ціні 0,10 грн
			// не бере участі в нарахуванні.
			// Усі інші товари чека нараховують зірки стандартно.
			// ========================================================

			ЭтоТоварЗаЗірки =
				ЗначениеЗаполнено(
					КодQRЗаЗірки
				)
				И НЕ ЗначениеЗаполнено(
					КодПерсональнойСкидки
				)
				И ЦенаКоп = 10;


			Если ЭтоТоварЗаЗірки Тогда

				Флаги.no_star_accrual =
					Истина;

				Флаги.no_redeem =
					Истина;


				// Вище технічні 10 копійок уже могли бути
				// додані до суми, з якої нараховуються зірки.
				// Прибираємо тільки цей рядок.
				РазрешеннаяСуммаКоп =
					РазрешеннаяСуммаКоп
					-
					СуммаСтрокиКоп;


				Если РазрешеннаяСуммаКоп < 0 Тогда

					РазрешеннаяСуммаКоп =
						0;

				КонецЕсли;

		
				// Раніше технічні 10 копійок уже потрапляли
				// в eligible_cents. Прибираємо їх.
				РазрешеннаяСуммаКоп =
					РазрешеннаяСуммаКоп
					-
					СуммаСтрокиКоп;


				Если РазрешеннаяСуммаКоп < 0 Тогда

					РазрешеннаяСуммаКоп =
						0;

				КонецЕсли;

			КонецЕсли;

			ТоварJSON.Вставить("flags", Флаги);
			ТоварыJSON.Добавить(ТоварJSON);
		КонецЦикла;

		ДанныеЧека.Вставить("eligible_cents", РазрешеннаяСуммаКоп);
		ДанныеЧека.Вставить("items", ТоварыJSON);
        ЗаписьJSONDebug =
	Новый ЗаписьJSON;

ЗаписьJSONDebug.
	УстановитьСтроку();

ЗаписатьJSON(
	ЗаписьJSONDebug,
	ДанныеЧека
);

ТелоЧекаDebug =
	ЗаписьJSONDebug.
		Закрыть();


Сообщить(
	"[STARCLUB RECEIPT DEBUG] "
	+ "Запит на /api/1c/receipts:"
	+ Символы.ПС
	+ ТелоЧекаDebug
);
		HTTPОтвет = StarClubPOST("/api/1c/receipts", ДанныеЧека);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния >= 200
	И HTTPОтвет.КодСостояния < 300 Тогда

	Сообщить(
		"Star Club: фіскальний чек синхронізовано."
	);

	StarClubDebugЗдача(
		"RECEIPT_SYNC_BEFORE_COMPLETE",
		"Чек="
			+ StarClubНомерДокумента(
				ДокументЧек
			)
			+ "; ID="
			+ StarClubИдентификаторДокумента(
				ДокументЧек
			)
	);

	Попытка

		ПідтвердитиЗарахуванняЗдачіЗаЧекомStarClub(
			ДокументЧек
		);

		StarClubDebugЗдача(
			"RECEIPT_SYNC_COMPLETE_FINISHED",
			"Підтвердження зарахування завершилося без виключення"
		);

	Исключение

		StarClubDebugЗдача(
			"RECEIPT_SYNC_COMPLETE_EXCEPTION",
			ОписаниеОшибки()
		);

		Сообщить(
			"Star Club: чек синхронізовано, але зарахування здачі "
			+ "не підтверджено: "
			+ ОписаниеОшибки()
		);

	КонецПопытки;

Иначе

	Сообщить(
		"Star Club: помилка API. Код: "
		+ Строка(
			HTTPОтвет.КодСостояния
		)
		+ ". Відповідь: "
		+ ОтветСтрока
	);

КонецЕсли;	Исключение
		Сообщить("Star Club: помилка відправки чека: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция StarClubЗнайтиИсходныйЧекВозврата(ДокументВозврат) Экспорт
	// Реквізит первинного продажу в конфігурації «Роздріб для України».
	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ЧекККМПродажа) Тогда
			Возврат ДокументВозврат.ЧекККМПродажа;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ЧекККМОснование) Тогда
			Возврат ДокументВозврат.ЧекККМОснование;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ДокументОснование) Тогда
			Возврат ДокументВозврат.ДокументОснование;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.Основание) Тогда
			Возврат ДокументВозврат.Основание;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ЗначениеЗаполнено(ДокументВозврат.ЧекККМ) Тогда
			Возврат ДокументВозврат.ЧекККМ;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;
КонецФункции

Процедура ОтправитьВозвратВStarClub(ДокументВозврат, ИсходныйЧек = Неопределено) Экспорт
	Попытка
		Если ИсходныйЧек = Неопределено Тогда
			ИсходныйЧек = StarClubЗнайтиИсходныйЧекВозврата(ДокументВозврат);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ИсходныйЧек) Тогда
			Сообщить("Star Club: повернення не відправлено — не знайдено первинний чек. Вкажіть документ продажу та повторіть синхронізацію повернення. Зірки не нараховуються.");
			Возврат;
		КонецЕсли;

		ИсходныйОбъект = ИсходныйЧек;
		Попытка
			ИсходныйОбъект = ИсходныйЧек.ПолучитьОбъект();
		Исключение
		КонецПопытки;

		Если НЕ ЗначениеЗаполнено(ИсходныйОбъект.ДисконтнаяКарта) Тогда
			// За первинним чеком без картки зірки не нараховувались.
			Возврат;
		КонецЕсли;

		ДанныеВозврата = Новый Структура;
		ДанныеВозврата.Вставить("id", Строка(ДокументВозврат.Ссылка));
		ДанныеВозврата.Вставить("fiscal_number", Строка(ДокументВозврат.Номер));
		// Продаж у цьому модулі має id = СокрЛП(Строка(ДокументЧек.Номер)).
		ДанныеВозврата.Вставить("original_receipt_id", СокрЛП(Строка(ИсходныйОбъект.Номер)));
		ДанныеВозврата.Вставить("is_return", Истина);
		ДанныеВозврата.Вставить("returned_at", Формат(ДокументВозврат.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		StarClubДодатиМагазинВДані(ДанныеВозврата, ДокументВозврат.Магазин);
		ДанныеВозврата.Вставить("cash_register", Строка(ДокументВозврат.КассаККМ));
		ДанныеВозврата.Вставить("cashier", Строка(ДокументВозврат.Продавец));
		ДанныеВозврата.Вставить("total_cents", Окр(ДокументВозврат.СуммаДокумента * 100, 0));
		ДанныеВозврата.Вставить("card_number", Строка(ИсходныйОбъект.ДисконтнаяКарта.КодКарты));

		ТоварыJSON = Новый Массив;
		РазрешеннаяСуммаКоп = 0;
		Для Каждого СтрокаТовара Из ДокументВозврат.Товары Цикл
			ТоварJSON = Новый Структура;
			СуммаСтрокиКоп = Окр(StarClubАбсолютнеЧисло(СтрокаТовара.Сумма) * 100, 0);
			ЦенаКоп = Окр(StarClubАбсолютнеЧисло(СтрокаТовара.Цена) * 100, 0);
			StarClubДодатиКодиТоваруІГрупи(ТоварJSON, СтрокаТовара.Номенклатура);
			ТоварJSON.Вставить("name", Строка(СтрокаТовара.Номенклатура.Наименование));
			ТоварJSON.Вставить("qty", StarClubАбсолютнеЧисло(СтрокаТовара.Количество));
			ТоварJSON.Вставить("price_cents", ЦенаКоп);
			ТоварJSON.Вставить("line_total_cents", СуммаСтрокиКоп);
			ТоварыJSON.Добавить(ТоварJSON);
			РазрешеннаяСуммаКоп = РазрешеннаяСуммаКоп + СуммаСтрокиКоп;
		КонецЦикла;

		ДанныеВозврата.Вставить("eligible_cents", РазрешеннаяСуммаКоп);
		ДанныеВозврата.Вставить("items", ТоварыJSON);
		// Порожня таблиця не означає повне повернення: сервер має перевірити позиції.
		ДанныеВозврата.Вставить("full_return", Ложь);

		HTTPОтвет = StarClubPOST("/api/1c/returns", ДанныеВозврата);
		ОтветСтрока = HTTPОтвет.ПолучитьТелоКакСтроку();
		Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
			Сообщить("Star Club: повернення синхронізовано, нараховані зірки скориговано.");
		Иначе
			Сообщить("Star Club: помилка повернення. Код: " + Строка(HTTPОтвет.КодСостояния) + ". Відповідь: " + ОтветСтрока);
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка синхронізації повернення: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ОбробитиПробитийЧекStarClub(ДокументЧек) Экспорт
	// Викликати ТІЛЬКИ після успішного фіскального пробиття у РМК.
	Попытка
		ЭтоВозврат = StarClubЦеПовернення(ДокументЧек);

		Если ЭтоВозврат Тогда
			ОтправитьВозвратВStarClub(ДокументЧек);
		Иначе
			ОтправитьЧекВStarClub(ДокументЧек);
		КонецЕсли;
	Исключение
		Сообщить("Star Club: помилка обробки пробитого чека: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
// ============================================================================
// РЕЄСТР ЗАРАХУВАННЯ ЧАСТИНИ ЗДАЧІ STARCLUB
// ============================================================================

Процедура StarClubЗаписатиОпераціюЗдачі(
	ИдентификаторОперации,
	СуммаЗачисления,
	КодКарты,
	ДокументЧек,
	КассаККМ,
	Магазин,
	Кассир,
	СтатусОперации,
	ФискальныйНомер = "",
	Комментарий = ""
) Экспорт
    	StarClubDebugЗдача(
		"REGISTER_WRITE_START",
		"operation_id="
			+ Строка(
				ИдентификаторОперации
			)
			+ "; Статус="
			+ Строка(
				СтатусОперации
			)
			+ "; Сума="
			+ Строка(
				СуммаЗачисления
			)
			+ "; Чек="
			+ StarClubНомерДокумента(
				ДокументЧек
			)
			+ "; Каса="
			+ Строка(
				КассаККМ
			)
	);
	Если СокрЛП(Строка(ИдентификаторОперации)) = "" Тогда
		ВызватьИсключение
			"Star Club: не вказано ідентифікатор операції.";
	КонецЕсли;

	НаборЗаписей =
		РегистрыСведений.
			ЗачисленияСдачиStarClub.
				СоздатьНаборЗаписей();

	НаборЗаписей.Отбор.
		ИдентификаторОперации.
			Установить(
				Строка(ИдентификаторОперации)
			);

	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() = 0 Тогда
		Запись = НаборЗаписей.Добавить();
	Иначе
		Запись = НаборЗаписей[0];
	КонецЕсли;

	Запись.Период =
		ТекущаяДата();

	Запись.ИдентификаторОперации =
		Строка(ИдентификаторОперации);
    	StarClubDebugЗдача(
		"PREPARE_OPERATION_ID",
		"operation_id="
			+ Строка(
				ИдентификаторОперации
			)
	);
	Запись.СуммаЗачисления =
		Окр(
			Число(СуммаЗачисления),
			2
		);

	Запись.КодКарты =
		ОчиститиКодКартиStarClub(
			КодКарты
		);

	Запись.Статус =
		Строка(СтатусОперации);

	Запись.Кассир =
		Строка(Кассир);

	Запись.ФискальныйНомер =
		Строка(ФискальныйНомер);

	Запись.Комментарий =
		Лев(
			Строка(Комментарий),
			250
		);

	Если ЗначениеЗаполнено(КассаККМ) Тогда
		Запись.КассаККМ =
			КассаККМ;
	КонецЕсли;

	Если ЗначениеЗаполнено(Магазин) Тогда
		Запись.Магазин =
			Магазин;
	КонецЕсли;

	Попытка
		Если ДокументЧек <> Неопределено Тогда
			Если ТипЗнч(ДокументЧек)
				= Тип("ДокументСсылка.ЧекККМ") Тогда

				Запись.ЧекККМ =
					ДокументЧек;

				Запись.НомерЧека =
					Строка(
						ДокументЧек.Номер
					);

			Иначе

				Запись.ЧекККМ =
					ДокументЧек.Ссылка;

				Запись.НомерЧека =
					Строка(
						ДокументЧек.Номер
					);

			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	НаборЗаписей.Записать();
    	StarClubDebugЗдача(
		"REGISTER_WRITE_SUCCESS",
		"operation_id="
			+ Строка(
				ИдентификаторОперации
			)
			+ "; Статус="
			+ Строка(
				СтатусОперации
			)
	);
КонецПроцедуры


Функция StarClubОпераціяЗдачіВжеПроведена(
	ИдентификаторОперации
) Экспорт

	Если СокрЛП(
		Строка(
			ИдентификаторОперации
		)
	) = "" Тогда

		Возврат Ложь;

	КонецЕсли;

	Запрос =
		Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Зачисления.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ЗачисленияСдачиStarClub КАК Зачисления
		|ГДЕ
		|	Зачисления.ИдентификаторОперации =
		|		&ИдентификаторОперации";

	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		Строка(
			ИдентификаторОперации
		)
	);

	Выборка =
		Запрос.Выполнить().
			Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат
		Выборка.Статус = "Проведено";

	КонецФункции
	
Функция ПідготуватиЗарахуванняЗдачіStarClub(
	КодКарты,
	СуммаЗачисления,
	ДокументЧек,
	Магазин,
	КассаККМ,
	Кассир = ""
) Экспорт

	StarClubDebugЗдача(
		"PREPARE_START",
		"Карта="
			+ Строка(
				КодКарты
			)
			+ "; Сума="
			+ Строка(
				СуммаЗачисления
			)
			+ "; Чек="
			+ StarClubНомерДокумента(
				ДокументЧек
			)
			+ "; Каса="
			+ Строка(
				КассаККМ
			)
			+ "; Магазин="
			+ Строка(
				Магазин
			)
	);


	КодКарты =
		ОчиститиКодКартиStarClub(
			КодКарты
		);
	КодКарты =
		ОчиститиКодКартиStarClub(
			КодКарты
		);

	Если КодКарты = "" Тогда
		ВызватьИсключение
			"Star Club: не вибрана картка клієнта.";
	КонецЕсли;

	СуммаЗачисления =
		Окр(
			Число(СуммаЗачисления),
			2
		);

	Если СуммаЗачисления <= 0 Тогда
		ВызватьИсключение
			"Star Club: сума повинна бути більшою за нуль.";
	КонецЕсли;

	Данные =
		Новый Структура;

	Данные.Вставить(
		"card_token",
		КодКарты
	);

	Данные.Вставить(
		"amount_cents",
		Окр(
			СуммаЗачисления * 100,
			0
		)
	);

	Данные.Вставить(
		"source",
		"change_from_1c"
	);

	Данные.Вставить(
		"receipt_id",
		StarClubИдентификаторДокумента(
			ДокументЧек
		)
	);

	Данные.Вставить(
		"receipt_number",
		StarClubНомерДокумента(
			ДокументЧек
		)
	);

	Данные.Вставить(
		"cash_register",
		Строка(
			КассаККМ
		)
	);

	Данные.Вставить(
		"cashier",
		Строка(
			Кассир
		)
	);

	StarClubДодатиМагазинВДані(
		Данные,
		Магазин
	);
    	StarClubDebugЗдача(
		"PREPARE_BEFORE_HTTP",
		"URL=/api/1c/change-accrual/prepare"
			+ "; Карта="
			+ Строка(
				КодКарты
			)
			+ "; Сума="
			+ Строка(
				СуммаЗачисления
			)
	);
	HTTPОтвет =
		StarClubPOST(
			"/api/1c/change-accrual/prepare",
			Данные
		);

	ОтветСтрока =
		HTTPОтвет.
			ПолучитьТелоКакСтроку();

	Если HTTPОтвет.КодСостояния < 200
		Или HTTPОтвет.КодСостояния >= 300 Тогда

		ВызватьИсключение
			"Star Club: сервер відхилив операцію. Код "
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ ". "
			+ ОтветСтрока;

	КонецЕсли;

	ОтветДанные =
		StarClubПрочитатьJSON(
			ОтветСтрока
		);

	ИдентификаторОперации =
		Строка(
			StarClubОтриматиПоле(
				ОтветДанные,
				"operation_id",
				""
			)
		);

	Если СокрЛП(
		ИдентификаторОперации
	) = "" Тогда

		ВызватьИсключение
			"Star Club: сервер не повернув operation_id.";

	КонецЕсли;

	StarClubЗаписатиОпераціюЗдачі(
		ИдентификаторОперации,
		СуммаЗачисления,
		КодКарты,
		ДокументЧек,
		КассаККМ,
		Магазин,
		Кассир,
		"Подготовлено"
	);
    	StarClubDebugЗдача(
		"PREPARE_REGISTER_WRITTEN",
		"operation_id="
			+ Строка(
				ИдентификаторОперации
			)
			+ "; Статус=Подготовлено"
			+ "; Сума="
			+ Строка(
				СуммаЗачисления
			)
	);
	Результат =
		Новый Структура;

	Результат.Вставить(
		"Успех",
		Истина
	);

	Результат.Вставить(
		"ИдентификаторОперации",
		ИдентификаторОперации
	);

	Результат.Вставить(
		"Сумма",
		СуммаЗачисления
	);

	Возврат Результат;

КонецФункции

Функция StarClubИдентификаторДокумента(
	Документ
) Экспорт

	Если Документ = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат
			Строка(
				Документ.Ссылка.
					УникальныйИдентификатор()
			);
	Исключение
	КонецПопытки;

	Попытка
		Возврат
			Строка(
				Документ.
					УникальныйИдентификатор()
			);
	Исключение
	КонецПопытки;

	Возврат
		Строка(
			Документ
		);

КонецФункции


Функция StarClubНомерДокумента(
	Документ
) Экспорт

	Если Документ = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат
			Строка(
				Документ.Номер
			);
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

// ============================================================================
// ЛОКАЛЬНЕ ПІДТВЕРДЖЕННЯ ЗАРАХУВАННЯ STARCLUB ЗА ПРОВЕДЕНИМ ЧЕКОМ
// ============================================================================

Процедура ПозначитиЗарахуванняЗдачіПроведенимStarClub(
	ДокументЧек,
	ФискальныйНомер = ""
) Экспорт

	Если ДокументЧек = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СсылкаЧека =
		Неопределено;

	Попытка
		СсылкаЧека =
			ДокументЧек.Ссылка;
	Исключение
		СсылкаЧека =
			ДокументЧек;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(
		СсылкаЧека
	) Тогда

		Возврат;

	КонецЕсли;


	НаборЗаписей =
		РегистрыСведений.
			ЗачисленияСдачиStarClub.
				СоздатьНаборЗаписей();

	НаборЗаписей.Отбор.
		ЧекККМ.
			Установить(
				СсылкаЧека
			);

	НаборЗаписей.Прочитать();


	Если НаборЗаписей.Количество() = 0 Тогда

		// Додаткова спроба пошуку за номером чека
		НомерЧека =
			StarClubНомерДокумента(
				ДокументЧек
			);

		Если СокрЛП(
			НомерЧека
		) = "" Тогда

			Возврат;

		КонецЕсли;


		Запрос =
			Новый Запрос;

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Зачисления.Период КАК Период,
			|	Зачисления.КассаККМ КАК КассаККМ,
			|	Зачисления.Магазин КАК Магазин,
			|	Зачисления.ИдентификаторОперации КАК ИдентификаторОперации
			|ИЗ
			|	РегистрСведений.ЗачисленияСдачиStarClub КАК Зачисления
			|ГДЕ
			|	Зачисления.НомерЧека = &НомерЧека
			|	И Зачисления.Статус = ""Подготовлено""
			|
			|УПОРЯДОЧИТЬ ПО
			|	Зачисления.Период УБЫВ";

		Запрос.УстановитьПараметр(
			"НомерЧека",
			НомерЧека
		);

		Выборка =
			Запрос.Выполнить().
				Выбрать();

		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;


		НаборЗаписей =
			РегистрыСведений.
				ЗачисленияСдачиStarClub.
					СоздатьНаборЗаписей();

		НаборЗаписей.Отбор.
			ИдентификаторОперации.
				Установить(
					Выборка.ИдентификаторОперации
				);

		НаборЗаписей.Прочитать();

	КонецЕсли;


	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;


	Для Каждого Запись
		Из НаборЗаписей Цикл

		Если Запись.Статус =
			"Подготовлено" Тогда

			Запись.Статус =
				"Проведено";

			Запись.ФискальныйНомер =
				Строка(
					ФискальныйНомер
				);

			Запись.Комментарий =
				"Зарахування підтверджено після проведення чека";

		КонецЕсли;

	КонецЦикла;


	НаборЗаписей.Записать();

КонецПроцедуры
// ============================================================================
// ДЕБАГ ЗАРАХУВАННЯ ЗДАЧІ STARCLUB
// ============================================================================

Процедура StarClubDebugЗдача(
	Этап,
	Данные = ""
) Экспорт

	ТекстСообщения =
		"[STARCLUB CHANGE DEBUG] "
		+ Формат(
			ТекущаяДата(),
			"ДФ=dd.MM.yyyy HH:mm:ss"
		)
		+ " | "
		+ Строка(
			Этап
		);

	Если СокрЛП(
		Строка(
			Данные
		)
	) <> "" Тогда

		ТекстСообщения =
			ТекстСообщения
			+ " | "
			+ Строка(
				Данные
			);

	КонецЕсли;

	Сообщить(
		ТекстСообщения
	);

	Попытка

		ЗаписьЖурналаРегистрации(
			"StarClub.ЗачислениеСдачи",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения
		);

	Исключение
		// Якщо журнал реєстрації в цій версії недоступний,
		// повідомлення все одно з’явиться у вікні повідомлень.
	КонецПопытки;

КонецПроцедуры
Процедура ПідтвердитиЗарахуванняЗдачіЗаЧекомStarClub(
	ДокументЧек,
	ФискальныйНомер = ""
) Экспорт

	StarClubDebugЗдача(
		"COMPLETE_START",
		"Чек="
			+ StarClubНомерДокумента(
				ДокументЧек
			)
	);

	Если ДокументЧек = Неопределено Тогда

		StarClubDebugЗдача(
			"COMPLETE_STOP",
			"ДокументЧек = Неопределено"
		);

		Возврат;

	КонецЕсли;


	СсылкаЧека =
		Неопределено;

	Попытка

		СсылкаЧека =
			ДокументЧек.Ссылка;

	Исключение

		СсылкаЧека =
			ДокументЧек;

	КонецПопытки;


	Запрос =
		Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Зачисления.ИдентификаторОперации КАК ИдентификаторОперации,
		|	Зачисления.СуммаЗачисления КАК СуммаЗачисления,
		|	Зачисления.КодКарты КАК КодКарты,
		|	Зачисления.КассаККМ КАК КассаККМ,
		|	Зачисления.Магазин КАК Магазин,
		|	Зачисления.Кассир КАК Кассир
		|ИЗ
		|	РегистрСведений.ЗачисленияСдачиStarClub КАК Зачисления
		|ГДЕ
		|	Зачисления.ЧекККМ = &ЧекККМ
		|	И Зачисления.Статус = ""Подготовлено""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Зачисления.Период УБЫВ";

	Запрос.УстановитьПараметр(
		"ЧекККМ",
		СсылкаЧека
	);


	Попытка

		Выборка =
			Запрос.Выполнить().
				Выбрать();

	Исключение

		StarClubDebugЗдача(
			"COMPLETE_QUERY_ERROR",
			ОписаниеОшибки()
		);

		Возврат;

	КонецПопытки;


	Если НЕ Выборка.Следующий() Тогда

		НомерЧека =
			StarClubНомерДокумента(
				ДокументЧек
			);

		StarClubDebugЗдача(
			"COMPLETE_SEARCH_BY_NUMBER",
			"Номер="
				+ НомерЧека
		);


		ЗапросПоНомеру =
			Новый Запрос;

		ЗапросПоНомеру.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Зачисления.ИдентификаторОперации КАК ИдентификаторОперации,
			|	Зачисления.СуммаЗачисления КАК СуммаЗачисления,
			|	Зачисления.КодКарты КАК КодКарты,
			|	Зачисления.КассаККМ КАК КассаККМ,
			|	Зачисления.Магазин КАК Магазин,
			|	Зачисления.Кассир КАК Кассир
			|ИЗ
			|	РегистрСведений.ЗачисленияСдачиStarClub КАК Зачисления
			|ГДЕ
			|	Зачисления.НомерЧека = &НомерЧека
			|	И Зачисления.Статус = ""Подготовлено""
			|
			|УПОРЯДОЧИТЬ ПО
			|	Зачисления.Период УБЫВ";

		ЗапросПоНомеру.УстановитьПараметр(
			"НомерЧека",
			НомерЧека
		);


		Попытка

			Выборка =
				ЗапросПоНомеру.
					Выполнить().
						Выбрать();

		Исключение

			StarClubDebugЗдача(
				"COMPLETE_NUMBER_QUERY_ERROR",
				ОписаниеОшибки()
			);

			Возврат;

		КонецПопытки;


			Если НЕ Выборка.Следующий() Тогда

		НомерЧекаДляПоиска =
			StarClubНомерДокумента(
				ДокументЧек
			);

		StarClubDebugЗдача(
			"COMPLETE_LINK_NOT_FOUND_TRY_NUMBER",
			"За посиланням не знайдено. Шукаємо номер="
				+ НомерЧекаДляПоиска
		);


		ЗапросПоНомеру =
			Новый Запрос;

		ЗапросПоНомеру.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Зачисления.ИдентификаторОперации КАК ИдентификаторОперации,
			|	Зачисления.СуммаЗачисления КАК СуммаЗачисления,
			|	Зачисления.КодКарты КАК КодКарты,
			|	Зачисления.КассаККМ КАК КассаККМ,
			|	Зачисления.Магазин КАК Магазин,
			|	Зачисления.Кассир КАК Кассир
			|ИЗ
			|	РегистрСведений.ЗачисленияСдачиStarClub КАК Зачисления
			|ГДЕ
			|	Зачисления.НомерЧека = &НомерЧека
			|	И Зачисления.Статус = ""Подготовлено""
			|
			|УПОРЯДОЧИТЬ ПО
			|	Зачисления.Период УБЫВ";

		ЗапросПоНомеру.УстановитьПараметр(
			"НомерЧека",
			НомерЧекаДляПоиска
		);


		Попытка

			Выборка =
				ЗапросПоНомеру.
					Выполнить().
						Выбрать();

		Исключение

			StarClubDebugЗдача(
				"COMPLETE_NUMBER_SEARCH_ERROR",
				ОписаниеОшибки()
			);

			Возврат;

		КонецПопытки;


		Если НЕ Выборка.Следующий() Тогда

			StarClubDebugЗдача(
				"COMPLETE_REGISTER_NOT_FOUND",
				"Не знайдено ні за посиланням, ні за номером. Чек="
					+ НомерЧекаДляПоиска
			);

			Возврат;

		КонецЕсли;

	КонецЕсли;


	StarClubDebugЗдача(
		"COMPLETE_REGISTER_FOUND",
		"operation_id="
			+ Строка(
				Выборка.ИдентификаторОперации
			)
			+ "; Сума="
			+ Строка(
				Выборка.СуммаЗачисления
			)
			+ "; Карта="
			+ Строка(
				Выборка.КодКарты
			)
	);

	КонецЕсли;


	StarClubDebugЗдача(
		"COMPLETE_REGISTER_FOUND",
		"operation_id="
			+ Строка(
				Выборка.ИдентификаторОперации
			)
			+ "; Сума="
			+ Строка(
				Выборка.СуммаЗачисления
			)
	);


	Данные =
		Новый Структура;

	Данные.Вставить(
		"operation_id",
		Строка(
			Выборка.ИдентификаторОперации
		)
	);

		НомерЧекаStarClub =
		StarClubНомерДокумента(
			ДокументЧек
		);


	Данные.Вставить(
		"receipt_id",
		НомерЧекаStarClub
	);


	Данные.Вставить(
		"receipt_number",
		НомерЧекаStarClub
	);


	Данные.Вставить(
		"document_uuid",
		StarClubИдентификаторДокумента(
			ДокументЧек
		)
	);


	Если СокрЛП(
		Строка(
			ФискальныйНомер
		)
	) = "" Тогда

		ФискальныйНомер =
			НомерЧекаStarClub;

	КонецЕсли;


	Данные.Вставить(
		"fiscal_receipt_number",
		Строка(
			ФискальныйНомер
		)
	);

	StarClubDebugЗдача(
		"COMPLETE_BEFORE_HTTP",
		"operation_id="
			+ Строка(
				Выборка.ИдентификаторОперации
			)
	);


	HTTPОтвет =
		StarClubPOST(
			"/api/1c/change-accrual/complete",
			Данные
		);

	ОтветСтрока =
		HTTPОтвет.ПолучитьТелоКакСтроку();


	StarClubDebugЗдача(
		"COMPLETE_HTTP_RESPONSE",
		"Код="
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ "; Відповідь="
			+ ОтветСтрока
	);


	Если HTTPОтвет.КодСостояния >= 200
		И HTTPОтвет.КодСостояния < 300 Тогда

		StarClubЗаписатиОпераціюЗдачі(
			Выборка.ИдентификаторОперации,
			Выборка.СуммаЗачисления,
			Выборка.КодКарты,
			ДокументЧек,
			Выборка.КассаККМ,
			Выборка.Магазин,
			Выборка.Кассир,
			"Проведено",
			ФискальныйНомер,
			"Зарахування підтверджено після фіскального чека"
		);
		Сообщить(
	"[STARCLUB REGISTER DEBUG] Записано Проведено"
	+ " | operation_id="
	+ Строка(
		Выборка.ИдентификаторОперации
	)
	+ " | Сума="
	+ Строка(
		Выборка.СуммаЗачисления
	)
	+ " | Каса="
	+ Строка(
		Выборка.КассаККМ
	)
);

		StarClubDebugЗдача(
			"COMPLETE_LOCAL_REGISTER_COMPLETED",
			"operation_id="
				+ Строка(
					Выборка.ИдентификаторОперации
				)
		);

	Иначе

		StarClubDebugЗдача(
			"COMPLETE_BACKEND_ERROR",
			ОтветСтрока
		);

		Сообщить(
			"Star Club: backend не підтвердив зарахування. Код: "
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ ". Відповідь: "
			+ ОтветСтрока
		);

	КонецЕсли;

КонецПроцедуры
Функция СкасуватиЗарахуванняЗдачіStarClub(
	ИдентификаторОперации,
	Причина = ""
) Экспорт

	ИдентификаторОперации =
		СокрЛП(
			Строка(
				ИдентификаторОперации
			)
		);

	Если ИдентификаторОперации = "" Тогда
		Возврат Истина;
	КонецЕсли;


	Данные =
		Новый Структура;

	Данные.Вставить(
		"operation_id",
		ИдентификаторОперации
	);

	Данные.Вставить(
		"reason",
		Строка(
			Причина
		)
	);


	Попытка

		HTTPОтвет =
			StarClubPOST(
				"/api/1c/change-accrual/cancel",
				Данные
			);

		ОтветСтрока =
			HTTPОтвет.
				ПолучитьТелоКакСтроку();

		StarClubDebugЗдача(
			"CANCEL_HTTP_RESPONSE",
			"operation_id="
				+ ИдентификаторОперации
				+ "; Код="
				+ Строка(
					HTTPОтвет.КодСостояния
				)
				+ "; Відповідь="
				+ ОтветСтрока
		);


		Если HTTPОтвет.КодСостояния < 200
			Или HTTPОтвет.КодСостояния >= 300 Тогда

			Возврат Ложь;

		КонецЕсли;


		НаборЗаписей =
			РегистрыСведений.
				ЗачисленияСдачиStarClub.
					СоздатьНаборЗаписей();

		НаборЗаписей.Отбор.
			ИдентификаторОперации.
				Установить(
					ИдентификаторОперации
				);

		НаборЗаписей.Прочитать();


		Для Каждого Запись
			Из НаборЗаписей Цикл

			Запись.Статус =
				"Отменено";

			Запись.Комментарий =
				Лев(
					Строка(
						Причина
					),
					250
				);

		КонецЦикла;


		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Записать();
		КонецЕсли;


		Возврат Истина;

	Исключение

		StarClubDebugЗдача(
			"CANCEL_EXCEPTION",
			ОписаниеОшибки()
		);

		Возврат Ложь;

	КонецПопытки;

КонецФункции

// ============================================================================
// STAR CLUB — ПОПОВНЕННЯ, СУМИ КАСИ ТА БЛОКУВАННЯ КРЕДИТУ
// 1 зірка = 1 копійка
// ============================================================================

Функция StarClubЗіркиЗГривень(
	СуммаГрн
) Экспорт

	СуммаГрн =
		Окр(
			Число(СуммаГрн),
			2
		);

	Возврат
		Окр(
			СуммаГрн * 100,
			0
		);

КонецФункции


Функция StarClubГривніЗЗірок(
	КоличествоЗвезд
) Экспорт

	Возврат
		Окр(
			Число(КоличествоЗвезд) / 100,
			2
		);

КонецФункции


Функция StarClubОтриматиКодКартиЗПосилання(
	Карта
) Экспорт

	Если НЕ ЗначениеЗаполнено(Карта) Тогда
		Возврат "";
	КонецЕсли;

	КодКарты = "";

	Попытка
		КодКарты =
			Строка(
				Карта.КодКарты
			);
	Исключение
	КонецПопытки;

	Если СокрЛП(КодКарты) = "" Тогда
		Попытка
			КодКарты =
				Строка(
					Карта.КодКартки
				);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Если СокрЛП(КодКарты) = "" Тогда
		Попытка
			КодКарты =
				Строка(
					Карта.Код
				);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат
		ОчиститиКодКартиStarClub(
			КодКарты
		);

КонецФункции


Функция StarClubЦеКарткаStarClub(
	Карта
) Экспорт

	Если НЕ ЗначениеЗаполнено(Карта) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		Название =
			НРег(
				Строка(
					Карта.Наименование
				)
			);

		Если СтрНайти(
			Название,
			"star club"
		) > 0 Тогда

			Возврат Истина;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Попытка

		НазваниеРодителя =
			НРег(
				Строка(
					Карта.Родитель.Наименование
				)
			);

		Если СтрНайти(
			НазваниеРодителя,
			"star club"
		) > 0 Тогда

			Возврат Истина;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Попытка

		Комментарий =
			НРег(
				Строка(
					Карта.Комментарий
				)
			);

		Если СтрНайти(
			Комментарий,
			"star club"
		) > 0 Тогда

			Возврат Истина;

		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Ложь;

КонецФункции


Функция StarClubПідготуватиПоповнення(
	КодКарты,
	СуммаГрн,
	ВидОплаты,
	ДокументЧек,
	Магазин,
	КассаККМ,
	Кассир = ""
) Экспорт

	КодКарты =
		ОчиститиКодКартиStarClub(
			КодКарты
		);

	Если КодКарты = "" Тогда
		ВызватьИсключение
			"Star Club: не вибрана картка клієнта.";
	КонецЕсли;


	СуммаГрн =
		Окр(
			Число(СуммаГрн),
			2
		);

	Если СуммаГрн <= 0 Тогда
		ВызватьИсключение
			"Star Club: сума поповнення повинна бути більшою за нуль.";
	КонецЕсли;


	ВидОплаты =
		НРег(
			СокрЛП(
				Строка(
					ВидОплаты
				)
			)
		);

	Если ВидОплаты = "готівка"
		Или ВидОплаты = "наличные"
		Или ВидОплаты = "cash" Тогда

		КодВидаОплаты = "cash";

	ИначеЕсли ВидОплаты = "картка"
		Или ВидОплаты = "карта"
		Или ВидОплаты = "безналичные"
		Или ВидОплаты = "card" Тогда

		КодВидаОплаты = "card";

	Иначе

		ВызватьИсключение
			"Star Club: невідомий спосіб оплати. Дозволено: Готівка або Картка.";

	КонецЕсли;


	Данные =
		Новый Структура;

	Данные.Вставить(
		"card_token",
		КодКарты
	);

	Данные.Вставить(
		"card_number",
		КодКарты
	);

	Данные.Вставить(
		"amount_cents",
		StarClubЗіркиЗГривень(
			СуммаГрн
		)
	);

	Данные.Вставить(
		"payment_method",
		КодВидаОплаты
	);

	Данные.Вставить(
		"operation_type",
		"topup"
	);

	Данные.Вставить(
		"source",
		"topup_from_1c"
	);

	Данные.Вставить(
		"receipt_id",
		StarClubИдентификаторДокумента(
			ДокументЧек
		)
	);

	Данные.Вставить(
		"receipt_number",
		StarClubНомерДокумента(
			ДокументЧек
		)
	);

	StarClubДодатиМагазинВДані(
		Данные,
		Магазин
	);

	Данные.Вставить(
		"cash_register",
		Строка(
			КассаККМ
		)
	);

	Данные.Вставить(
		"cashier",
		Строка(
			Кассир
		)
	);


	HTTPОтвет =
		StarClubPOST(
			"/api/1c/change-accrual/prepare",
			Данные
		);

	ОтветСтрока =
		HTTPОтвет.
			ПолучитьТелоКакСтроку();


	Если HTTPОтвет.КодСостояния < 200
		Или HTTPОтвет.КодСостояния >= 300 Тогда

		ВызватьИсключение
			"Star Club: поповнення не підготовлено. HTTP "
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ ". "
			+ ОтветСтрока;

	КонецЕсли;


	ОтветДанные =
		StarClubПрочитатьJSON(
			ОтветСтрока
		);

	ИдентификаторОперации =
		Строка(
			StarClubОтриматиПоле(
				ОтветДанные,
				"operation_id",
				""
			)
		);

	Если СокрЛП(
		ИдентификаторОперации
	) = "" Тогда

		ВызватьИсключение
			"Star Club: сервер не повернув operation_id для поповнення.";

	КонецЕсли;


	Результат =
		Новый Структура;

	Результат.Вставить(
		"Успех",
		Истина
	);

	Результат.Вставить(
		"ИдентификаторОперации",
		ИдентификаторОперации
	);

	Результат.Вставить(
		"Сумма",
		СуммаГрн
	);

	Результат.Вставить(
		"КоличествоЗвезд",
		StarClubЗіркиЗГривень(
			СуммаГрн
		)
	);

	Результат.Вставить(
		"ВидОплаты",
		КодВидаОплаты
	);

	Возврат Результат;

КонецФункции


Функция StarClubЗавершитиПоповнення(
	ИдентификаторОперации,
	ДокументЧек,
	ФискальныйНомер = "",
	Магазин = Неопределено,
	КассаККМ = Неопределено,
	Кассир = ""
) Экспорт

	ИдентификаторОперации =
		СокрЛП(
			Строка(
				ИдентификаторОперации
			)
		);

	Если ИдентификаторОперации = "" Тогда
		Возврат Ложь;
	КонецЕсли;


	Данные =
		Новый Структура;

	Данные.Вставить(
		"operation_id",
		ИдентификаторОперации
	);
	Данные.Вставить(
	"operation_type",
	"topup"
);

Данные.Вставить(
	"source",
	"topup_from_1c"
);

	Данные.Вставить(
		"receipt_id",
		StarClubИдентификаторДокумента(
			ДокументЧек
		)
	);

	Данные.Вставить(
		"receipt_number",
		StarClubНомерДокумента(
			ДокументЧек
		)
	);

	Данные.Вставить(
		"fiscal_receipt_number",
		Строка(
			ФискальныйНомер
		)
	);

	Если Магазин <> Неопределено Тогда
		StarClubДодатиМагазинВДані(
			Данные,
			Магазин
		);
	КонецЕсли;

	Данные.Вставить(
		"cash_register",
		Строка(
			КассаККМ
		)
	);

	Данные.Вставить(
		"cashier",
		Строка(
			Кассир
		)
	);


	HTTPОтвет =
		StarClubPOST(
			"/api/1c/change-accrual/complete",
			Данные
		);

	ОтветСтрока =
		HTTPОтвет.
			ПолучитьТелоКакСтроку();


	Если HTTPОтвет.КодСостояния < 200
		Или HTTPОтвет.КодСостояния >= 300 Тогда

		Сообщить(
			"Star Club: поповнення не підтверджено. HTTP "
			+ Строка(
				HTTPОтвет.КодСостояния
			)
			+ ". "
			+ ОтветСтрока
		);

		Возврат Ложь;

	КонецЕсли;


	Возврат Истина;

КонецФункции


Функция StarClubСкасуватиПоповнення(
	ИдентификаторОперации,
	Причина = "Операцію поповнення скасовано касиром"
) Экспорт

	ИдентификаторОперации =
		СокрЛП(
			Строка(
				ИдентификаторОперации
			)
		);

	Если ИдентификаторОперации = "" Тогда
		Возврат Истина;
	КонецЕсли;


	Данные =
		Новый Структура;

	Данные.Вставить(
		"operation_id",
		ИдентификаторОперации
	);
    Данные.Вставить(
	"operation_type",
	"topup"
);

Данные.Вставить(
	"source",
	"topup_from_1c"
);
	Данные.Вставить(
		"reason",
		Строка(
			Причина
		)
	);


	Попытка

		HTTPОтвет =
			StarClubPOST(
				"/api/1c/change-accrual/cancel",
				Данные
			);

		Если HTTPОтвет.КодСостояния >= 200
			И HTTPОтвет.КодСостояния < 300 Тогда

			Возврат Истина;

		КонецЕсли;

	Исключение
	КонецПопытки;


	Возврат Ложь;

КонецФункции


Процедура StarClubЗаблокуватиКредитНаФормі(
	Форма,
	Заблокувати = Истина
) Экспорт

	ИменаКнопок =
		Новый Массив;

	ИменаКнопок.Добавить("Кредит");
	ИменаКнопок.Добавить("КнопкаКредит");
	ИменаКнопок.Добавить("ОплатаКредит");
	ИменаКнопок.Добавить("КредитнаяОплата");
	ИменаКнопок.Добавить("КредитНажатие");
	ИменаКнопок.Добавить("ОсновныеДействияФормыКредит");


	Для Каждого ИмяКнопки
		Из ИменаКнопок Цикл

		Попытка

			Форма.
				ЭлементыФормы[
					ИмяКнопки
				].
					Доступность =
						НЕ Заблокувати;

		Исключение
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры


Процедура StarClubЗаписатиСумиУФормуРозрахунку(
	ФормаРозрахунку,
	СуммаStarClub,
	СуммаТоваров
) Экспорт

	СуммаStarClub =
		Окр(
			Число(
				СуммаStarClub
			),
			2
		);

	СуммаТоваров =
		Окр(
			Число(
				СуммаТоваров
			),
			2
		);

	ОбщаяСумма =
		СуммаТоваров
		+ СуммаStarClub;


	StarClubБезопасноУстановить(
		ФормаРозрахунку,
		"СуммаStarClub",
		СуммаStarClub
	);

	StarClubБезопасноУстановить(
		ФормаРозрахунку,
		"СумаStarClub",
		СуммаStarClub
	);

	StarClubБезопасноУстановить(
		ФормаРозрахунку,
		"СуммаПополненияStarClub",
		СуммаStarClub
	);

	StarClubБезопасноУстановить(
		ФормаРозрахунку,
		"СуммаКОплате",
		ОбщаяСумма
	);

	StarClubБезопасноУстановить(
		ФормаРозрахунку,
		"ОбщаяСумма",
		ОбщаяСумма
	);

КонецПроцедуры
