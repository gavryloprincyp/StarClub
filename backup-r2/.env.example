# Set these ONLY in the Railway BACKUP SERVICE Variables tab; never commit secrets.
DATABASE_URL=${{Postgres.DATABASE_URL}}
R2_ACCOUNT_ID=YOUR_32_HEX_CHARACTER_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=starclub-backups
R2_PREFIX=starclub/postgres
# Generate once on your machine: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SAVE THIS KEY IN A PASSWORD MANAGER. If lost, encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=YOUR_44_CHARACTER_BASE64_VALUE
